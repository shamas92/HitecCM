@model IEnumerable<HitecCM.Models.tblMenuType>
@Html.AntiForgeryToken()

@{
    ViewBag.Title = "Manage Menu Types";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Menu Types</h3>
                    <div class="nk-block-des text-soft">
                        <p>Manage all menu types and their details.</p>
                    </div>
                </div>
                <div class="nk-block-head-content text-center">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <em class="icon ni ni-plus"></em>
                            <span>Add New Menu Type</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner-group">
                    <div class="card-inner">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Menu Type ID</th>
                                        <th>Menu Type Name</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.MenuTypeID</td>
                                            <td>
                                                <span class="tb-lead">@item.MenuTypeName</span>
                                            </td>
                                            <td class="nk-tb-col nk-tb-col-tools">
                                                <ul class="gx-1">
                                                    <li>
                                                        <div class="drodown">
                                                            <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-toggle="dropdown">
                                                                <em class="icon ni ni-more-h"></em>
                                                            </a>
                                                            <div class="dropdown-menu dropdown-menu-right">
                                                                <ul class="link-list-opt no-bdr">
                                                                    <li>
                                                                        <a href="@Url.Action("Edit", new { id = item.MenuTypeID })">
                                                                            <em class="icon ni ni-edit"></em>
                                                                            <span>Edit</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a href="#" class="delete-menu-type" data-id="@item.MenuTypeID">
                                                                            <em class="icon ni ni-trash"></em>
                                                                            <span>Delete</span>
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Handle delete functionality
            $('.delete-menu-type').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var token = $('input[name="__RequestVerificationToken"]').val();
                
                if (confirm('Are you sure you want to delete this menu type?')) {
                    $.ajax({
                        url: '@Url.Action("Delete")',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: token
                        },
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            } else {
                                alert('Error deleting menu type: ' + result.message);
                            }
                        },
                        error: function () {
                            alert('Error deleting menu type.');
                        }
                    });
                }
            });
        });
    </script>
} 