@model HitecCM.Models.tblDepartment

@{
    ViewBag.Title = "Delete Department";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Delete Department</h3>
                    <div class="nk-block-des text-soft">
                        <p>Are you sure you want to delete this department?</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning!</strong> This action cannot be undone. All related data will be permanently deleted.
                    </div>

                    <div class="form-group">
                        <label class="form-label">Department ID</label>
                        <div class="form-control-plaintext">@Model.DepartmentID</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Department Code</label>
                        <div class="form-control-plaintext">@(Model.Code ?? "-")</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Department Title</label>
                        <div class="form-control-plaintext">@(Model.Title ?? "-")</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Banner</label>
                        <div class="form-control-plaintext">
                            @if (!string.IsNullOrEmpty(Model.Banner))
                            {
                                <div style="width: 200px; height: 120px; background-image: url('@Url.Content("~/Content/img/departments/" + Model.Banner)'); background-size: cover; background-position: center; border-radius: 4px; border: 1px solid #ddd;"></div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">About</label>
                        <div class="form-control-plaintext">@(string.IsNullOrEmpty(Model.About) ? "-" : Model.About)</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">HOD Photo</label>
                        <div class="form-control-plaintext">
                            @if (!string.IsNullOrEmpty(Model.HODPhoto))
                            {
                                <div style="width: 100px; height: 100px; background-image: url('@Url.Content("~/Content/img/departments/" + Model.HODPhoto)'); background-size: cover; background-position: center; border-radius: 50%; border: 1px solid #ddd;"></div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">HOD Message</label>
                        <div class="form-control-plaintext">@(string.IsNullOrEmpty(Model.HODMessage) ? "-" : Model.HODMessage)</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Programs</label>
                        <div class="form-control-plaintext">@(string.IsNullOrEmpty(Model.Programs) ? "-" : Model.Programs)</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Contacts</label>
                        <div class="form-control-plaintext">@(string.IsNullOrEmpty(Model.Contacts) ? "-" : Model.Contacts)</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Display Order</label>
                        <div class="form-control-plaintext">@(Model.C_Order?.ToString() ?? "-")</div>
                    </div>

                    @using (Html.BeginForm("Delete", "Departments", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.DepartmentID)

                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">
                                <em class="icon ni ni-trash"></em>
                                <span>Delete Department</span>
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <em class="icon ni ni-cross"></em>
                                <span>Cancel</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 