@model HitecCM.Models.tblFacilite

@{
    ViewBag.Title = "Add New Facility";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Add New Facility</h3>
                    <div class="nk-block-des text-soft">
                        <p>Create a new facility with its details.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    @using (Html.BeginForm("Create", "DepartmentFacilities", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            @Html.LabelFor(model => model.Title, "Facility Title", new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Title, new { @class = "form-control", placeholder = "Enter facility title" })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DepartmentID, "Department", new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.DepartmentID, (IEnumerable<SelectListItem>)ViewBag.DepartmentItems, "Select Department", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.DepartmentID, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Banner, "Banner Image", new { @class = "form-label" })
                            <div class="form-control-wrap">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="bannerFile" name="bannerFile" accept="image/*">
                                    <label class="custom-file-label" for="bannerFile">Choose file</label>
                                </div>
                                <div class="mt-3">
                                    <img id="imagePreview" src="#" alt="Image Preview" style="display: none; max-width: 100%; height: auto;" />
                                    <button type="button" id="cropImageBtn" class="btn btn-outline-primary mt-2" style="display: none;" data-toggle="modal" data-target="#cropModal">
                                        <em class="icon ni ni-crop"></em>
                                        <span>Crop Image</span>
                                    </button>
                                </div>
                                <input type="hidden" id="croppedImageData" name="croppedImageData" />
                            </div>
                            @Html.ValidationMessageFor(model => model.Banner, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Details, "Details", new { @class = "form-label" })
                            <div>
                                <div class="summernote-minimal"></div>
                            </div>
                            @Html.HiddenFor(model => model.Details, new { id = "DetailsHidden" })
                            @Html.ValidationMessageFor(model => model.Details, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.C_Order, "Display Order", new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.C_Order, new { @class = "form-control", type = "number", placeholder = "Enter display order" })
                            @Html.ValidationMessageFor(model => model.C_Order, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <div class="custom-control custom-switch">
                                @Html.CheckBox("Active", Model.Active.GetValueOrDefault(), new { @class = "custom-control-input", id = "activeSwitch" })
                                @Html.Hidden("Active", false)
                                <label class="custom-control-label" for="activeSwitch">Active</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <em class="icon ni ni-save"></em>
                                <span>Save Facility</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Crop Modal -->
<div class="modal fade" id="cropModal" tabindex="-1" role="dialog" aria-labelledby="cropModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cropModalLabel">Crop Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div class="crop-container">
                    <!-- Control Panel (Left Side) -->
                    <div class="crop-control-panel">
                        <div class="control-section">
                            <h6 class="control-heading">Crop Rectangle</h6>
                            <div class="control-group">
                                <div class="control-item">
                                    <label>Width</label>
                                    <input type="number" id="cropWidth" class="form-control" min="1" />
                                </div>
                                <div class="control-item">
                                    <label>Height</label>
                                    <input type="number" id="cropHeight" class="form-control" min="1" />
                                </div>
                            </div>
                        </div>

                        <div class="control-section">
                            <h6 class="control-heading">Crop Position</h6>
                            <div class="control-group">
                                <div class="control-item">
                                    <label>Position (X)</label>
                                    <input type="number" id="cropX" class="form-control" min="0" />
                                </div>
                                <div class="control-item">
                                    <label>Position (Y)</label>
                                    <input type="number" id="cropY" class="form-control" min="0" />
                                </div>
                            </div>
                        </div>

                        <div class="control-section">
                            <h6 class="control-heading">Aspect Ratio</h6>
                            <select id="aspectRatio" class="form-control">
                                <option value="free">FreeForm</option>
                                <option value="1:1">1:1 (Square)</option>
                                <option value="4:3">4:3</option>
                                <option value="16:9">16:9</option>
                                <option value="3:2">3:2</option>
                            </select>
                        </div>

                        <div class="control-actions">
                            <button type="button" id="applyCrop" class="btn btn-primary btn-crop">
                                <span>Crop</span>
                                <em class="icon ni ni-arrow-right"></em>
                            </button>
                            <button type="button" id="resetCrop" class="btn btn-secondary btn-reset">
                                <span>Reset</span>
                            </button>
                        </div>
                    </div>

                    <!-- Workspace (Right Side) -->
                    <div class="crop-workspace">
                        <div class="image-container">
                            <img id="cropImage" src="" alt="Image to crop" />
                            <div id="cropSelection" class="crop-selection">
                                <div class="crop-handle crop-handle-nw"></div>
                                <div class="crop-handle crop-handle-n"></div>
                                <div class="crop-handle crop-handle-ne"></div>
                                <div class="crop-handle crop-handle-e"></div>
                                <div class="crop-handle crop-handle-se"></div>
                                <div class="crop-handle crop-handle-s"></div>
                                <div class="crop-handle crop-handle-sw"></div>
                                <div class="crop-handle crop-handle-w"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            $(".custom-file-input").on("change", function () {
                var fileName = $(this).val().split("\\").pop();
                $(this).siblings(".custom-file-label").addClass("selected").html(fileName);

                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').attr('src', e.target.result).show();
                        $('#cropImageBtn').show();
                    }
                    reader.readAsDataURL(file);
                } else {
                    $('#imagePreview').hide();
                    $('#cropImageBtn').hide();
                }
            });

            // Form submit handler to ensure content is saved
            $('form').on('submit', function() {
                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.summernote) {
                    var content = $('.summernote-minimal').summernote('code');
                    $('#DetailsHidden').val(content);
                }
            });
        });
    </script>
}