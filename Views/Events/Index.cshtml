@model IEnumerable<HitecCM.Models.tblEvent>
@Html.AntiForgeryToken()

@{
    ViewBag.Title = "Manage Events";
    var deptTitles = ViewBag.DepartmentTitles as System.Collections.Generic.IDictionary<int, string>;
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Events</h3>
                    <div class="nk-block-des text-soft">
                        <p>Manage all events and their details.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <em class="icon ni ni-plus"></em>
                            <span>Add New Event</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner-group">
                    <div class="card-inner p-0">
                        <div class="table-responsive">
                            <table class="table table-events">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center" width="80">ID</th>
                                        <th width="25%">Event Details</th>
                                        <th class="text-center" width="140">Banner</th>
                                        <th width="120">Date</th>
                                        <th width="180">Venue</th>
                                        <th width="150">Head</th>
                                        <th width="150">Department</th>
                                        <th class="text-center" width="100">Status</th>
                                        <th class="text-center" width="80">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="event-row">
                                            <td class="text-center align-middle">
                                                <span class="event-id">#@item.EventID</span>
                                            </td>
                                            <td class="align-middle">
                                                <div class="event-title-wrapper">
                                                    <h6 class="event-title mb-0">@item.Title</h6>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                @if (!string.IsNullOrEmpty(item.Banner))
                                                {
                                                    <div class="event-banner-wrapper">
                                                        <img src="@Url.Content("~/Content/img/events/" + item.Banner)" 
                                                             alt="@item.Title" 
                                                             class="event-banner-thumb" 
                                                             onclick="showImagePreview(this.src)" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No Image</span>
                                                }
                                            </td>
                                            <td class="align-middle">
                                                <div class="event-date">
                                                    <span>@(item.EventDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="event-venue">
                                                    <span>@(item.Venue ?? "-")</span>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="event-meta">
                                                    @(item.tblEventHead?.Title ?? "-")
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="event-meta">
                                                    @{
                                                        if (item.DepartmentID.HasValue && deptTitles != null && deptTitles.ContainsKey(item.DepartmentID.Value))
                                                        {
                                                            @deptTitles[item.DepartmentID.Value]
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                @if (item.Active == true)
                                                {
                                                    <span class="badge bg-success-dim text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-dim text-danger">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="dropdown">
                                                    <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-toggle="dropdown">
                                                        <em class="icon ni ni-more-h"></em>
                                                    </a>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <ul class="link-list-opt no-bdr">
                                                            <li>
                                                                <a href="@Url.Action("Edit", new { id = item.EventID })">
                                                                    <em class="icon ni ni-edit"></em>
                                                                    <span>Edit</span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a href="#" class="delete-event" data-id="@item.EventID">
                                                                    <em class="icon ni ni-trash"></em>
                                                                    <span>Delete</span>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document" style="max-width: 1200px;">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <button type="button" class="close position-absolute" style="right: 20px; top: 20px; z-index: 10; color: #fff; font-size: 2rem; opacity: 1;" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body p-0 d-flex justify-content-center align-items-center" style="background: transparent;">
                <img id="previewImage" src="" alt="Event Banner" style="max-width: 1150px; max-height: 600px; width: auto; height: auto; display: block; margin: 0 auto; border-radius: 8px; box-shadow: 0 2px 16px rgba(0,0,0,0.3);" />
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" tabindex="-1" id="deleteConfirmationModal">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross"></em>
            </a>
            <div class="modal-header">
                <h5 class="modal-title">Delete Confirmation</h5>
            </div>
            <div class="modal-body">
                <p id="deleteModalBody"></p>
                <input type="hidden" id="deleteEventId" />
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">Delete</button>
            </div>
        </div>
    </div>
</div> 

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        $(document).ready(function () {
            // Delete confirmation
            $('.delete-event').click(function (e) {
                e.preventDefault();
                var eventId = $(this).data('id');
                $('#deleteEventId').val(eventId);
                $('#deleteModalBody').text('Are you sure you want to delete this event?');
                $('#deleteConfirmationModal').modal('show');
            });

            // Confirm delete button AJAX
            $('#confirmDeleteButton').click(function () {
                var eventId = $('#deleteEventId').val();
                if (!eventId) return;
                $.ajax({
                    url: '/Events/Delete/' + eventId,
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val(),
                        id: eventId
                    },
                    success: function (response) {
                        if (response.success) {
                            $('#deleteConfirmationModal').modal('hide');
                            location.reload();
                        } else {
                            alert(response.message || 'Delete failed.');
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting.');
                    }
                });
            });

            // Image preview function
            window.showImagePreview = function(imageSrc) {
                $('#previewImage').attr('src', imageSrc);
                $('#imagePreviewModal').modal('show');
            }

            // Initialize dropdowns
            $('.dropdown-toggle').dropdown();
        });
    </script>

    <style>
        /* Events Table Classic Design */
        .table-events {
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .table-events thead th {
            background-color: #f5f6fa;
            color: #364a63;
            font-weight: 600;
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
            border-bottom: 2px solid #e5e9f2;
            border-top: none;
        }

        .table-events tbody td {
            padding: 1rem 0.75rem;
            border-bottom: 1px solid #f0f1f5;
            vertical-align: middle;
            color: #526484;
            font-size: 0.875rem;
        }

        .table-events tbody tr:last-child td {
            border-bottom: none;
        }

        /* Event Row */
        .event-row {
            background-color: #fff;
        }

        .event-row:hover {
            background-color: #f8f9fb;
        }

        /* Event ID */
        .event-id {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            background-color: #f5f6fa;
            color: #526484;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.8125rem;
        }

        /* Event Title */
        .event-title-wrapper {
            max-width: 100%;
        }

        .event-title {
            color: #364a63;
            font-weight: 600;
            font-size: 0.9375rem;
            line-height: 1.4;
            margin: 0;
        }

        /* Event Banner */
        .event-banner-wrapper {
            display: inline-block;
        }

        .event-banner-thumb {
            width: 100px;
            height: 60px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #e5e9f2;
            cursor: pointer;
        }

        /* Event Date */
        .event-date {
            display: flex;
            align-items: center;
            color: #526484;
        }

        .event-date .icon {
            font-size: 1rem;
            margin-right: 0.375rem;
        }

        /* Event Venue */
        .event-venue {
            display: flex;
            align-items: center;
            color: #526484;
        }

        .event-venue .icon {
            font-size: 1rem;
            margin-right: 0.375rem;
        }

        /* Event Meta (Head, Department) */
        .event-meta {
            color: #526484;
            font-size: 0.875rem;
        }

        /* Badge Styling */
        .badge {
            padding: 0.375rem 0.75rem;
            font-weight: 500;
            font-size: 0.75rem;
            border-radius: 4px;
        }

        .bg-success-dim {
            background-color: #e6f4ea;
        }

        .text-success {
            color: #1c7c54 !important;
        }

        .bg-danger-dim {
            background-color: #fdecea;
        }

        .text-danger {
            color: #c4183c !important;
        }

        /* Responsive */
        @@media (max-width: 1400px) {
            .table-events thead th,
            .table-events tbody td {
                padding: 0.75rem 0.5rem;
            }
        }

        @@media (max-width: 1200px) {
            .event-banner-thumb {
                width: 80px;
                height: 50px;
            }
        }
    </style>
}
