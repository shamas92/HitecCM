@model HitecCM.Models.tblEvent
@{
    ViewBag.Title = "Edit Event";
    var eventHeads = ViewBag.EventHeads as SelectList;
    var departments = ViewBag.Departments as SelectList;
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Edit Event</h3>
                    <div class="nk-block-des text-soft">
                        <p>Modify event details.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    @using (Html.BeginForm("Edit", "Events", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.EventID)
                        @Html.HiddenFor(m => m.Banner)
                        @Html.HiddenFor(m => m.Views)
                        
                        <div class="form-group">
                            @Html.LabelFor(m => m.Title, "Event Title", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter event title" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label("Event Date", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.EventDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                    @Html.ValidationMessageFor(m => m.EventDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label("Date (Created)", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                    @Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.EventHeadID, "Event Head", new { @class = "form-label" })
                                    @if (eventHeads != null)
                                    {
                                        @Html.DropDownListFor(m => m.EventHeadID, eventHeads, "-- Select Event Head --", new { @class = "form-control form-select" })
                                    }
                                    else
                                    {
                                        <select class="form-control form-select" name="EventHeadID">
                                            <option value="">-- No Event Heads Available --</option>
                                        </select>
                                    }
                                    @Html.ValidationMessageFor(m => m.EventHeadID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.DepartmentID, "Department", new { @class = "form-label" })
                                    @if (departments != null)
                                    {
                                        @Html.DropDownListFor(m => m.DepartmentID, departments, "-- Select Department --", new { @class = "form-control form-select" })
                                    }
                                    else
                                    {
                                        <select class="form-control form-select" name="DepartmentID">
                                            <option value="">-- No Departments Available --</option>
                                        </select>
                                    }
                                    @Html.ValidationMessageFor(m => m.DepartmentID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Venue, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Venue, new { @class = "form-control", placeholder = "Enter venue name" })
                            @Html.ValidationMessageFor(m => m.Venue, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Banner, "Banner Image", new { @class = "form-label" })
                            <div class="form-control-wrap">
                                @if (!string.IsNullOrEmpty(Model.Banner))
                                {
                                    <div class="mb-2">
                                        <img id="imagePreview" src="@Url.Content("~/Content/img/events/" + Model.Banner)" style="max-width: 100%; max-height: 300px; border: 2px dashed #ccc;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-2">
                                        <img id="imagePreview" src="#" style="max-width: 100%; max-height: 300px; border: 2px dashed #ccc; display: none;" />
                                    </div>
                                }
                                <div class="custom-file">
                                    <input type="file" name="bannerFile" class="custom-file-input" id="bannerFile">
                                    <label class="custom-file-label" for="bannerFile">Choose file</label>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="alumni-switch" name="AlumniEvent" value="true" @(Model.AlumniEvent == true ? "checked" : "") />
                                        <input type="hidden" name="AlumniEvent" value="false" />
                                        <label class="custom-control-label" for="alumni-switch">Alumni Event</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="active-switch" name="Active" value="true" @(Model.Active == true ? "checked" : "") />
                                        <input type="hidden" name="Active" value="false" />
                                        <label class="custom-control-label" for="active-switch">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Details, "Details", new { @class = "form-label" })
                            <div>
                                <div class="summernote-minimal"></div>
                                @Html.HiddenFor(m => m.Details, new { id = "DetailsHidden" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Details, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-primary">
                                <em class="icon ni ni-save"></em>
                                <span>Save Changes</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Update custom file input label with filename when selected
            $('.custom-file-input').on('change', function() {
                var fileName = $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').html(fileName || "Choose file");
                
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').attr('src', e.target.result).show();
                    }
                    reader.readAsDataURL(file);
                } else {
                    $('#imagePreview').hide();
                }
            });
            
            // Set initial content for Summernote editor
            var initialContent = $("#DetailsHidden").val();
            if (initialContent) {
                // Wait for the editor to be initialized by the global script
                setTimeout(function() {
                    if (window.jQuery && window.jQuery.fn && window.jQuery.fn.summernote) {
                        $('.summernote-minimal').summernote('code', initialContent);
                    }
                }, 100);
            }

            // Form submit handler to ensure content is saved
            $('form').on('submit', function() {
                if ($.fn.summernote) {
                    var content = $('.summernote-minimal').summernote('code');
                    $('#DetailsHidden').val(content);
                }
            });
        });
    </script>
}
