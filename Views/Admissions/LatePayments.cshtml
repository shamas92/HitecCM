@model HitecCM.Models.tblLatePaymentPenalty
@{
    ViewBag.Title = "Fine/Penalties On Late Payments";
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">@ViewBag.Title</h3>
                    <div class="nk-block-des text-soft">
                        <p>Update the penalties information for late payments.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @using (Html.BeginForm("LatePayments", "Admissions", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.PenaltyID)

                        <div class="form-group">
                            @Html.LabelFor(m => m.PenaltyDetail, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.PenaltyDetail, new { @class = "form-control summernote-minimal", rows = 12 })
                            @Html.ValidationMessageFor(m => m.PenaltyDetail, null, new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Content/js/editors.js")
    <script>
        if (window.NioApp && NioApp.SummerNote) { NioApp.SummerNote(); }
    </script>
}
