@model HitecCM.Models.tblQAC
@{
    ViewBag.Title = ViewBag.Title ?? "About QA&C";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">About QA&C</h3>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    @using (Html.BeginForm("About", "QAC", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)
                        <div class="form-group">
                            @Html.LabelFor(m => m.PageTitle, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.PageTitle, new { @class = "form-control", placeholder = "Title" })
                            @Html.ValidationMessageFor(m => m.PageTitle)
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.PageText, new { @class = "form-label" })
                            <div>
                                <div class="summernote-minimal"></div>
                                @Html.HiddenFor(m => m.PageText, new { id = "PageTextHidden" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PageText)
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}