@model HitecCM.Models.tblQAPolicy
@{
    ViewBag.Title = ViewBag.Title ?? "Quality Assurance Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Quality Assurance Policy</h3>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    @using (Html.BeginForm("Policy", "QAC", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)
                        <div class="form-group">
                            @Html.LabelFor(m => m.PageTitle, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.PageTitle, new { @class = "form-control", placeholder = "Title" })
                            @Html.ValidationMessageFor(m => m.PageTitle)
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.PageText, new { @class = "form-label" })
                            <div>
                                <div class="summernote-minimal"></div>
                                @Html.HiddenFor(m => m.PageText, new { id = "PageTextHidden" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PageText)
                        </div>
                        <div class="form-group">
                            <label class="form-label">Upload PDF</label>
                            <div class="custom-file">
                                <input type="file" name="pdfFile" class="custom-file-input" accept="application/pdf">
                                <label class="custom-file-label">Choose PDF</label>
                            </div>
                            @if (!string.IsNullOrEmpty(Model?.PdfFilePath))
                            {
                                <p class="mt-2">Current: <a href="@Url.Content(Model.PdfFilePath)" target="_blank">@Model.PdfFileName</a></p>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            $(document).on('change', '.custom-file-input', function () {
                var fileName = $(this).val().split('\\').pop();
                $(this).siblings('.custom-file-label').addClass("selected").html(fileName || 'Choose PDF');
            });

            if ($.fn.summernote && !$('.summernote-minimal').hasClass('initialized')) {
                $('.summernote-minimal').addClass('initialized').summernote({
                    placeholder: 'Enter policy details...',
                    tabsize: 2,
                    height: 300,
                    fontNames: ['Arial', 'Arial Black', 'Calibri', 'Times New Roman', 'Courier New', 'Verdana', 'Montserrat', 'Poppins'],
                    fontNamesIgnoreCheck: ['Montserrat', 'Poppins'],
                    fontSizes: ['8', '9', '10', '11', '12', '14', '16', '18', '24', '36', '48', '64'],
                    toolbar: [
                        ['style', ['style']],
                        ['font', ['bold', 'italic', 'underline', 'strikethrough', 'superscript', 'subscript', 'clear']],
                        ['fontname', ['fontname']],
                        ['fontsize', ['fontsize']],
                        ['color', ['color']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['height', ['height']],
                        ['table', ['table']],
                        ['insert', ['link', 'picture', 'video']],
                        ['view', ['fullscreen', 'codeview', 'help']]
                    ]
                });
            }

            var initial = $('#PageTextHidden').val();
            if (initial && $.fn.summernote) {
                $('.summernote-minimal').summernote('code', initial);
            }

            $('form').on('submit', function () {
                if ($.fn.summernote) {
                    var content = $('.summernote-minimal').summernote('code');
                    $('#PageTextHidden').val(content);
                }
            });
        });
    </script>
}