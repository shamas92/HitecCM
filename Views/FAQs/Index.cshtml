@model IEnumerable<HitecCM.Controllers.FAQViewModel>
@{ ViewBag.Title = "FAQs"; }
@Html.AntiForgeryToken()

<div class="nk-content-inner">
  <div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
      <div class="nk-block-between">
        <div class="nk-block-head-content">
          <h3 class="nk-block-title page-title">FAQs</h3>
          <div class="nk-block-des text-soft">
            <p>Manage frequently asked questions.</p>
          </div>
        </div>
        <div class="nk-block-head-content">
          <div class="toggle-wrap nk-block-tools-toggle d-flex">
            <a href="@Url.Action("Create")" class="btn btn-primary mr-2">
              <em class="icon ni ni-plus"></em>
              <span>Add New FAQ</span>
            </a>
            <button type="button" class="btn btn-outline-light" data-toggle="collapse" data-target="#filterPanel">Filters</button>
          </div>
        </div>
      </div>
    </div>

    <div id="filterPanel" class="collapse mb-3 @(Request.QueryString.Count>0 ? "show" : "")">
      <div class="card card-bordered">
        <div class="card-inner">
          @using (Html.BeginForm("Index","FAQs",FormMethod.Get)) {
            <div class="row g-3">
              <div class="col-md-6">
                <div class="form-group">
                  <label class="form-label">Question</label>
                  <input type="text" name="question" value="@ViewBag.FilterQuestion" class="form-control" placeholder="Search questions..." />
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label class="form-label">Department</label>
                  @Html.DropDownList("departmentId", (SelectList)ViewBag.Departments, "-- Any Department --", new { @class = "form-control" })
                </div>
              </div>
              <div class="col-12">
                <div class="form-group d-flex justify-content-end">
                  <button type="submit" class="btn btn-primary mr-2">
                    <em class="icon ni ni-search"></em>
                    <span>Apply Filters</span>
                  </button>
                  <a href="@Url.Action("Index")" class="btn btn-light">
                    <em class="icon ni ni-reload"></em>
                    <span>Reset</span>
                  </a>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>

    @if (TempData["Success"]!=null){
      <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"></button>
      </div>
    }

    <div class="nk-block">
      <div class="card card-bordered card-stretch">
        <div class="card-inner p-0">
          <div class="table-responsive">
            <table class="table table-faculty">
              <thead class="thead-light">
                <tr>
                  <th class="text-center" width="70">ID</th>
                  <th>Question</th>
                  <th>Answer</th>
                  <th width="180">Department</th>
                  <th class="text-center" width="110">Actions</th>
                </tr>
              </thead>
              <tbody>
              @if(Model!=null && Model.Any()){
                foreach(var item in Model){
                <tr>
                  <td class="text-center">
                    <span class="badge bg-light text-dark">@item.FAQID</span>
                  </td>
                  <td>
                    <div class="faq-question">
                      <strong>@(item.Question ?? "-")</strong>
                    </div>
                  </td>
                  <td>
                    <div class="faq-answer text-truncate" style="max-width: 400px;" title="@(item.Answer ?? "-")">
                      @(item.Answer ?? "-")
                    </div>
                  </td>
                  <td>
                    @item.DepartmentName
                  </td>
                  <td class="text-center">
                    <div class="dropdown">
                      <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-toggle="dropdown">
                        <em class="icon ni ni-more-h"></em>
                      </a>
                      <div class="dropdown-menu dropdown-menu-right">
                        <ul class="link-list-opt no-bdr">
                          <li>
                            <a href="@Url.Action("Edit", new { id = item.FAQID })">
                              <em class="icon ni ni-edit"></em>
                              <span>Edit</span>
                            </a>
                          </li>
                          <li>
                            <a href="#" class="del-item" data-id="@item.FAQID" data-title="@(item.Question ?? "this FAQ")">
                              <em class="icon ni ni-trash"></em>
                              <span>Delete</span>
                            </a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </td>
                </tr>
                }
              } else {
                <tr>
                  <td colspan="5" class="text-center py-5">
                    <div class="empty-state">
                      <em class="icon ni ni-question-circle" style="font-size: 3rem; color: #e5e9f2;"></em>
                      <h6 class="mt-3 text-muted">No FAQs Found</h6>
                      <p class="text-muted small">There are no frequently asked questions matching your criteria.</p>
                      <a href="@Url.Action("Create")" class="btn btn-primary btn-sm mt-2">
                        <em class="icon ni ni-plus"></em>
                        <span>Add First FAQ</span>
                      </a>
                    </div>
                  </td>
                </tr>
              }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="delModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-sm" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        <p id="delText"></p>
        <input type="hidden" id="delId" />
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDelBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script>
$(function(){
  $('.del-item').on('click',function(e){
    e.preventDefault();
    $('#delId').val($(this).data('id'));
    $('#delText').text('Delete ' + ($(this).data('title') || 'this item') + '?');
    $('#delModal').modal('show');
  });

  $('#confirmDelBtn').on('click',function(){
    var id = $('#delId').val();
    if(!id) return;
    $.post('@Url.Action("Delete")', {
      id: id,
      '__RequestVerificationToken': $('input[name=__RequestVerificationToken]').val()
    }, function(r){
      if(r && r.success){
        location.reload();
      } else {
        alert((r && r.message) || 'Delete failed');
      }
    });
  });
});
</script>
<style>
.table-faculty { margin-bottom:0; border-collapse:separate; border-spacing:0; }
.table-faculty thead th { background:#f5f6fa; font-size:.7rem; text-transform:uppercase; letter-spacing:.5px; font-weight:600; color:#364a63; padding:.75rem .55rem; border-bottom:2px solid #e5e9f2; border-top: none; }
.table-faculty tbody td { padding:.75rem .55rem; border-bottom:1px solid #f0f1f5; vertical-align: middle; color:#526484; font-size:.78rem; }
.table-faculty tbody tr:last-child td { border-bottom: none; }
.table-faculty tbody tr:hover { background-color: #f8f9fb; }
.faq-question { font-weight: 600; color: #364a63; line-height: 1.4; }
.faq-question strong { display: block; margin-bottom: 0; }
.faq-answer { color: #526484; line-height: 1.4; }
.badge { font-size:.65rem; padding:.35rem .55rem; border-radius:4px; }
.text-truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
<script>
/* Responsive improvements - using JavaScript instead of CSS media queries */
if (window.innerWidth <= 768) {
    var style = document.createElement('style');
    style.textContent = `
        .table-faculty thead th,
        .table-faculty tbody td {
            padding: .5rem .25rem !important;
            font-size: .7rem !important;
        }
        .faq-answer {
            max-width: 200px !important;
        }
    `;
    document.head.appendChild(style);
}
</script>
}