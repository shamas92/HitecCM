@{
    ViewBag.Title = "HITEC CM Dashboard";
    // Safely extract QuickStats dynamic values to avoid RuntimeBinderException when properties are missing
    int qsTotalAcademicPrograms = 0, qsTotalContent = 0, qsTotalQAPolicies = 0, qsTotalStudentServices = 0;
    var quickStats = ViewBag.QuickStats;
    if (quickStats != null)
    {
        Func<string, int> getInt = name => {
            try
            {
                var prop = quickStats.GetType().GetProperty(name);
                if (prop != null)
                {
                    var val = prop.GetValue(quickStats, null);
                    if (val != null)
                    {
                        int parsed;
                        if (int.TryParse(val.ToString(), out parsed)) return parsed;
                    }
                }
            }
            catch { }
            return 0;
        };
        qsTotalAcademicPrograms = getInt("TotalAcademicPrograms");
        qsTotalContent = getInt("TotalContent");
        qsTotalQAPolicies = getInt("TotalQAPolicies");
        qsTotalStudentServices = getInt("TotalStudentServices");
    }

    // Helper utilities for safely reading anonymous/dynamic objects (avoids RuntimeBinderException)
    Func<object, string, string> dynStr = (obj, prop) => {
        try
        {
            if (obj == null) return string.Empty;
            var p = obj.GetType().GetProperty(prop);
            if (p == null) return string.Empty;
            var v = p.GetValue(obj, null);
            return v == null ? string.Empty : v.ToString();
        }
        catch { return string.Empty; }
    };
    Func<object, string, int?> dynInt = (obj, prop) => {
        try
        {
            var s = dynStr(obj, prop);
            if (string.IsNullOrWhiteSpace(s)) return null;
            int val; if (int.TryParse(s, out val)) return val; return null;
        }
        catch { return null; }
    };
    Func<object, string, DateTime?> dynDate = (obj, prop) => {
        try
        {
            if (obj == null) return null;
            var p = obj.GetType().GetProperty(prop);
            if (p == null) return null;
            var v = p.GetValue(obj, null);
            if (v == null) return null;
            if (v is DateTime) return (DateTime)v;
            DateTime dt; if (DateTime.TryParse(v.ToString(), out dt)) return dt; return null;
        }
        catch { return null; }
    };
}

