@{
    ViewBag.Title = "HITEC CM Dashboard";
    // Safely extract QuickStats dynamic values to avoid RuntimeBinderException when properties are missing
    int qsTotalAcademicPrograms = 0, qsTotalContent = 0, qsTotalQAPolicies = 0, qsTotalStudentServices = 0;
    var quickStats = ViewBag.QuickStats;
    if (quickStats != null)
    {
        Func<string, int> getInt = name => {
            try
            {
                var prop = quickStats.GetType().GetProperty(name);
                if (prop != null)
                {
                    var val = prop.GetValue(quickStats, null);
                    if (val != null)
                    {
                        int parsed;
                        if (int.TryParse(val.ToString(), out parsed)) return parsed;
                    }
                }
            }
            catch { }
            return 0;
        };
        qsTotalAcademicPrograms = getInt("TotalAcademicPrograms");
        qsTotalContent = getInt("TotalContent");
        qsTotalQAPolicies = getInt("TotalQAPolicies");
        qsTotalStudentServices = getInt("TotalStudentServices");
    }

    // Helper utilities for safely reading anonymous/dynamic objects (avoids RuntimeBinderException)
    Func<object, string, string> dynStr = (obj, prop) => {
        try
        {
            if (obj == null) return string.Empty;
            var p = obj.GetType().GetProperty(prop);
            if (p == null) return string.Empty;
            var v = p.GetValue(obj, null);
            return v == null ? string.Empty : v.ToString();
        }
        catch { return string.Empty; }
    };
    Func<object, string, int?> dynInt = (obj, prop) => {
        try
        {
            var s = dynStr(obj, prop);
            if (string.IsNullOrWhiteSpace(s)) return null;
            int val; if (int.TryParse(s, out val)) return val; return null;
        }
        catch { return null; }
    };
    Func<object, string, DateTime?> dynDate = (obj, prop) => {
        try
        {
            if (obj == null) return null;
            var p = obj.GetType().GetProperty(prop);
            if (p == null) return null;
            var v = p.GetValue(obj, null);
            if (v == null) return null;
            if (v is DateTime) return (DateTime)v;
            DateTime dt; if (DateTime.TryParse(v.ToString(), out dt)) return dt; return null;
        }
        catch { return null; }
    };
}

<div class="nk-content-inner">
    <div class="nk-content-body" id="content-section">
        <!-- Analytics Partial Injected -->
        @Html.Partial("_AnalyticsDashboard")
        
        <!-- Key Performance Indicators -->
        <div class="nk-block">
            <div class="row g-gs">
                <!-- Active Events -->
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-bordered metric-card card-fade-in" data-metric="active-events">
                        <div class="card-inner">
                            <div class="card-title-group align-start mb-2">
                                <div class="card-title">
                                    <h6 class="title">Active Events</h6>
                                </div>
                                <div class="card-tools">
                                    <em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" data-placement="left" title="Currently active events"></em>
                                </div>
                            </div>
                            <div class="card-amount" aria-label="Active events count">
                                <span class="amount count-animation" data-target="@(ViewBag.ActiveEvents ?? 0)" data-format="int">0</span>
                                <span class="change up text-success" aria-label="Event growth percentage">
                                    <em class="icon ni ni-arrow-long-up"></em>
                                    @{ 
                                        var eventsGrowth = "0.0"; // percent
                                        try {
                                            if (ViewBag.GrowthMetrics != null) {
                                                dynamic growthMetrics = ViewBag.GrowthMetrics;
                                                int thisMonth = 0; int lastMonth = 0;
                                                try { thisMonth = growthMetrics.EventsThisMonth ?? 0; } catch {}
                                                try { lastMonth = growthMetrics.EventsLastMonth ?? 0; } catch {}
                                                if (lastMonth > 0) {
                                                    eventsGrowth = (((double)thisMonth - lastMonth) / lastMonth * 100.0).ToString("F1");
                                                } else if (thisMonth > 0) {
                                                    eventsGrowth = "100.0"; // brand new activity
                                                }
                                            }
                                        } catch { eventsGrowth = "0.0"; }
                                    }
                                    @eventsGrowth%
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Total Departments -->
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-bordered metric-card card-fade-in" data-metric="departments">
                        <div class="card-inner">
                            <div class="card-title-group align-start mb-2">
                                <div class="card-title">
                                    <h6 class="title">Departments</h6>
                                </div>
                                <div class="card-tools">
                                    <em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" data-placement="left" title="Total university departments"></em>
                                </div>
                            </div>
                            <div class="card-amount" aria-label="Total departments">
                                <span class="amount count-animation" data-target="@(ViewBag.TotalDepartments ?? 0)" data-format="int">0</span>
                                <span class="change neutral text-soft">
                                    <em class="icon ni ni-building"></em>
                                    Total
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Faculty Members -->
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-bordered metric-card card-fade-in" data-metric="faculty-members">
                        <div class="card-inner">
                            <div class="card-title-group align-start mb-2">
                                <div class="card-title">
                                    <h6 class="title">Faculty Members</h6>
                                </div>
                                <div class="card-tools">
                                    <em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" data-placement="left" title="Total faculty members"></em>
                                </div>
                            </div>
                            <div class="card-amount" aria-label="Faculty members count">
                                <span class="amount count-animation" data-target="@(ViewBag.TotalFaculties ?? 0)" data-format="int">0</span>
                                <span class="change neutral text-soft">
                                    <em class="icon ni ni-users"></em>
                                    Total
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Academic Programs -->
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-bordered metric-card card-fade-in" data-metric="academic-programs">
                        <div class="card-inner">
                            <div class="card-title-group align-start mb-2">
                                <div class="card-title">
                                    <h6 class="title">Academic Programs</h6>
                                </div>
                                <div class="card-tools">
                                    <em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" data-placement="left" title="Total academic programs"></em>
                                </div>
                            </div>
                            <div class="card-amount" aria-label="Academic programs count">
                                <span class="amount count-animation" data-target="@(qsTotalAcademicPrograms)" data-format="int">0</span>
                                <span class="change neutral text-soft">
                                    <em class="icon ni ni-book"></em>
                                    Total
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts and Analytics Row -->
        <div class="nk-block">
            <div class="row g-gs">
                <!-- Monthly Activity Chart -->
                <div class="col-xxl-6 col-md-6">
                    <div class="card card-bordered card-full" data-chart="monthly-activity">
                        <div class="card-inner">
                            <div class="card-title-group align-start mb-3">
                                <div class="card-title">
                                    <h6 class="title">Monthly Activity Trends</h6>
                                    <p>Events and news publication trends over the year</p>
                                </div>
                                <div class="card-tools">
                                    <em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" data-placement="left" title="Monthly activity comparison"></em>
                                </div>
                            </div>
                            <div class="nk-order-ovv">
                                <div class="row g-4 align-end">
                                    <div class="col-xxl-12">
                                        <div class="nk-order-ovv-ck">
                                            <canvas class="line-chart-s1" id="monthlyActivityChart" aria-label="Monthly events and news chart" role="img"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Department Performance Chart -->
                <div class="col-xxl-6 col-md-6">
                    <div class="card card-bordered card-full" data-chart="department-performance">
                        <div class="card-inner">
                            <div class="card-title-group align-start mb-3">
                                <div class="card-title">
                                    <h6 class="title">Department Performance</h6>
                                    <p>Events and faculty distribution by department</p>
                                </div>
                                <div class="card-tools">
                                    <em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" data-placement="left" title="Department activity metrics"></em>
                                </div>
                            </div>
                            <div class="nk-order-ovv">
                                <canvas class="bar-chart-s1" id="departmentChart" aria-label="Department performance chart" role="img"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        

        <!-- Recent Activities and Upcoming Events -->
        <div class="nk-block">
            <div class="row g-gs">
                <!-- Recent Events -->
                <div class="col-xxl-6 col-md-6">
                    <div class="card card-bordered card-full" data-table="recent-events">
                        <div class="card-inner">
                            <div class="card-title-group">
                                <div class="card-title">
                                    <h6 class="title">Recent Events</h6>
                                </div>
                                <div class="card-tools">
                                    <a href="@Url.Action("Index", "Events")" class="link">View All</a>
                                </div>
                            </div>
                        </div>
                        <div class="nk-tb-list" role="table" aria-label="Recent events table">
                            <div class="nk-tb-item nk-tb-head" role="row">
                                <div class="nk-tb-col" role="columnheader"><span>Event</span></div>
                                <div class="nk-tb-col tb-col-sm" role="columnheader"><span>Date</span></div>
                                <div class="nk-tb-col tb-col-sm" role="columnheader"><span>Views</span></div>
                            </div>
                            @{
                                var recentEvents = ViewBag.RecentEvents as IEnumerable<object> ?? Enumerable.Empty<object>();
                                foreach (var eventItem in recentEvents)
                                {
                                    var eTitle = dynStr(eventItem, "Title");
                                    var eVenue = dynStr(eventItem, "Venue");
                                    var eViews = dynInt(eventItem, "Views") ?? 0;
                                    var eDate = dynDate(eventItem, "EventDate");
                                    <div class="nk-tb-item" role="row">
                                        <div class="nk-tb-col" role="cell">
                                            <div class="user-card">
                                                <div class="user-avatar xs bg-primary-dim">
                                                    <em class="icon ni ni-calendar"></em>
                                                </div>
                                                <div class="user-name">
                                                    <span class="tb-lead">@eTitle</span>
                                                    <span class="tb-sub">@eVenue</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="nk-tb-col tb-col-sm" role="cell">
                                            <span class="tb-sub text-primary">@(eDate.HasValue ? eDate.Value.ToString("MMM dd") : "")</span>
                                        </div>
                                        <div class="nk-tb-col tb-col-sm" role="cell">
                                            <span class="tb-lead">@eViews</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <!-- Recent News -->
                <div class="col-xxl-6 col-md-6">
                    <div class="card card-bordered card-full" data-table="recent-news">
                        <div class="card-inner">
                            <div class="card-title-group">
                                <div class="card-title">
                                    <h6 class="title">Recent News</h6>
                                    <p>Latest news and announcements</p>
                                </div>
                                <div class="card-tools">
                                    <a href="#" class="link">View All</a>
                                </div>
                            </div>
                        </div>
                        <div class="nk-tb-list" role="table" aria-label="Recent news table">
                            @{
                                var recentNews = ViewBag.RecentNews as IEnumerable<object> ?? Enumerable.Empty<object>();
                                foreach (var n in recentNews)
                                {
                                    var nTitle = dynStr(n, "Title");
                                    var nViews = dynInt(n, "Views") ?? 0;
                                    var nDate = dynDate(n, "Date");
                                    <div class="nk-tb-item" role="row">
                                        <div class="nk-tb-col" role="cell">
                                            <div class="user-card">
                                                <div class="user-avatar xs bg-info-dim">
                                                    <em class="icon ni ni-news"></em>
                                                </div>
                                                <div class="user-name">
                                                    <span class="tb-lead">@nTitle</span>
                                                    <span class="tb-sub">@(nDate.HasValue ? nDate.Value.ToString("MMM dd, yyyy") : "") • @nViews views</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                
            </div>
        </div>



    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script src="~/Content/js/charts/gd-default.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Count up animation
        document.querySelectorAll('.count-animation').forEach(function(element) {
            const targetAttr = element.getAttribute('data-target');
            const target = parseInt(targetAttr) || 0;
            let current = 0;
            if (target > 0 && !prefersReducedMotion) {
                const steps = 40;
                const increment = Math.max(1, Math.ceil(target / steps));
                const timer = setInterval(function() {
                    current += increment;
                    if (current >= target) { current = target; clearInterval(timer); }
                    element.textContent = current.toLocaleString();
                }, 25);
            } else {
                element.textContent = target.toLocaleString();
            }
        });

        // Card fade in
        if(!prefersReducedMotion){
            document.querySelectorAll('.card-fade-in').forEach((card, index) => {
                card.style.opacity = '0';
                setTimeout(() => { card.style.opacity = '1'; card.style.animation = 'fadeInUp .6s ease-out forwards'; }, index * 100);
            });
        }

        // Monthly Activity Chart
        const monthlyData = @Html.Raw(Json.Encode(ViewBag.MonthlyEventStats ?? new List<object>()));
        if (monthlyData && monthlyData.length > 0 && document.getElementById('monthlyActivityChart')) {
            const ctx = document.getElementById('monthlyActivityChart').getContext('2d');
            new Chart(ctx, { type: 'line', data: { labels: monthlyData.map(m => m.MonthName), datasets: [ { label: 'Events', data: monthlyData.map(m => m.EventCount), borderColor: '#798bff', backgroundColor: 'rgba(121, 139, 255, 0.1)', borderWidth: 3, fill: true, tension: 0.4, pointBackgroundColor: '#798bff', pointBorderColor: '#fff', pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6 }, { label: 'News', data: monthlyData.map(m => m.NewsCount), borderColor: '#ff6b9d', backgroundColor: 'rgba(255, 107, 157, 0.1)', borderWidth: 3, fill: true, tension: 0.4, pointBackgroundColor: '#ff6b9d', pointBorderColor: '#fff', pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6 } ] }, options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' }, scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)', lineWidth: 1 }, ticks: { color: '#8fa8b2', font: { size: 12 } } }, x: { grid: { display: false }, ticks: { color: '#8fa8b2', font: { size: 12 } } } }, plugins: { legend: { display: true, position: 'top', labels: { usePointStyle: true, padding: 20, font: { size: 13 } } }, tooltip: { backgroundColor: 'rgba(255,255,255,.95)', titleColor: '#364a63', bodyColor: '#8fa8b2', borderColor: '#e5e9f2', borderWidth: 1, cornerRadius: 8, displayColors: true, padding: 12 } }, animation: { duration: prefersReducedMotion ? 0 : 1600, easing: 'easeInOutQuart' } } });
        }

        // Department Performance Chart
        const deptData = @Html.Raw(Json.Encode(ViewBag.DepartmentStats ?? new List<object>()));
        if (deptData && deptData.length > 0 && document.getElementById('departmentChart')) {
            const ctx2 = document.getElementById('departmentChart').getContext('2d');
            new Chart(ctx2, { type: 'bar', data: { labels: deptData.map(d => d.Code || d.DepartmentName.substring(0,8)), datasets: [ { label: 'Events', data: deptData.map(d => d.EventCount), backgroundColor: '#798bff', borderRadius: 6, borderSkipped: false, maxBarThickness: 50 }, { label: 'Faculty', data: deptData.map(d => d.FacultyCount), backgroundColor: '#ff9f43', borderRadius: 6, borderSkipped: false, maxBarThickness: 50 } ] }, options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' }, scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)', lineWidth: 1 }, ticks: { color: '#8fa8b2', font: { size: 12 } } }, x: { grid: { display: false }, ticks: { color: '#8fa8b2', font: { size: 12 } } } }, plugins: { legend: { display: true, position: 'top', labels: { usePointStyle: true, padding: 20, font: { size: 13 } } }, tooltip: { backgroundColor: 'rgba(255,255,255,.95)', titleColor: '#364a63', bodyColor: '#8fa8b2', borderColor: '#e5e9f2', borderWidth: 1, cornerRadius: 8, displayColors: true, padding: 12 } }, animation: { duration: prefersReducedMotion ? 0 : 1300, easing: 'easeInOutQuart' } } });
        }

        // Activity level progress bars (only for department table)
        document.querySelectorAll('[data-table="department-activity"] .badge').forEach(badge => {
            const parent = badge.closest('.nk-tb-col');
            if (!parent || badge.dataset.enhanced === '1') return;
            let width = 30; if (badge.textContent.includes('High')) width = 85; else if (badge.textContent.includes('Medium')) width = 60;
            parent.insertAdjacentHTML('beforeend', `<div class="activity-progress"><div class="activity-progress-bar" style="width:${width}%;"></div></div>`);
            badge.dataset.enhanced = '1';
        });

        // Tooltips
        if (window.jQuery) { $('[data-toggle="tooltip"]').tooltip({ animation: true, delay: { show: 300, hide: 100 }, html: true, placement: 'auto' }); }
    });
</script>
}