@using Newtonsoft.Json
@{
    var summary = ViewBag.AnalyticsSummary ?? new { TotalSessions = 0, TotalPageViews = 0, AvgPagesPerSession = 0d, BounceRatePct = 0d, AvgSessionDurationSec = 0d };
    var traffic = ViewBag.TrafficSeries as IEnumerable<object> ?? Enumerable.Empty<object>();
    var topPages = ViewBag.TopPages as IEnumerable<object> ?? Enumerable.Empty<object>();
    var hourly = ViewBag.HourlyViews as IEnumerable<object> ?? Enumerable.Empty<object>();
    string trafficJson = JsonConvert.SerializeObject(traffic);
    string hourlyJson = JsonConvert.SerializeObject(hourly);
    string topPagesJson = JsonConvert.SerializeObject(topPages);
    Func<object, string, object> getProp = (obj, name) => { try { return obj.GetType().GetProperty(name)?.GetValue(obj, null) ?? 0; } catch { return 0; } };
    // Helpers
    Func<dynamic, string, string> getStringProp = (obj, propName) => { try { var prop = obj.GetType().GetProperty(propName); if (prop != null) { var value = prop.GetValue(obj); return value != null ? value.ToString() : string.Empty; } } catch {} return string.Empty; };
    Func<dynamic, string, int> getIntProp = (obj, propName) => { try { var prop = obj.GetType().GetProperty(propName); if (prop != null) { var value = prop.GetValue(obj); if (value != null) { int result; if (int.TryParse(value.ToString(), out result)) { return result; } } } } catch {} return 0; };

    // Growth metrics (events/news) from controller
    dynamic growth = ViewBag.GrowthMetrics;
    int eventsThisMonth = 0, eventsLastMonth = 0, newsThisMonth = 0, newsLastMonth = 0;
    if (growth != null)
    {
        try { eventsThisMonth = growth.EventsThisMonth ?? 0; } catch {}
        try { eventsLastMonth = growth.EventsLastMonth ?? 0; } catch {}
        try { newsThisMonth = growth.NewsThisMonth ?? 0; } catch {}
        try { newsLastMonth = growth.NewsLastMonth ?? 0; } catch {}
    }
    string EventsDeltaPct()
    {
        if (eventsLastMonth == 0) return eventsThisMonth > 0 ? "+100%" : "0%";
        return ((eventsThisMonth - eventsLastMonth) * 100.0 / eventsLastMonth).ToString("+0.0;-0.0") + "%";
    }
    string NewsDeltaPct()
    {
        if (newsLastMonth == 0) return newsThisMonth > 0 ? "+100%" : "0%";
        return ((newsThisMonth - newsLastMonth) * 100.0 / newsLastMonth).ToString("+0.0;-0.0") + "%";
    }
    
    // Debug: Let's see what data we actually have
    var debugInfo = new {
        SummaryType = summary?.GetType().Name ?? "null",
        TotalSessions = getProp(summary, "TotalSessions"),
        TotalPageViews = getProp(summary, "TotalPageViews"),
        TrafficCount = traffic.Count(),
        TopPagesCount = topPages.Count(),
        HourlyCount = hourly.Count()
    };
}

<!-- Unified Analytics Section -->
<div id="analytics-section" class="nk-block dashboard-section pb-0">
    <div class="nk-block-head nk-block-head-sm mt-4 pt-2">
        <div class="nk-block-between g-3">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title d-flex align-items-center">
                    HITEC Content Management <strong class="text-primary ml-1">Dashboard</strong>
                </h3>
                <div class="nk-block-des text-soft">
                    <p class="mb-1">Unified operational and traffic intelligence workspace. Manage and monitor institutional digital presence.</p>
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <strong>Data Loading Notice:</strong> @ViewBag.ErrorMessage
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }
                    
                </div>
            </div>
            <div class="nk-block-head-content">
                <ul class="nk-block-tools g-3">
                    <li>
                        <div class="drodown">
                            <a href="#" class="dropdown-toggle btn btn-icon btn-primary" data-toggle="dropdown">
                                <em class="icon ni ni-plus"></em>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right">
                                <ul class="link-list-opt no-bdr">
                                    <li><a href="@Url.Action("Create", "Events")"><em class="icon ni ni-calendar"></em><span>Add Event</span></a></li>
                                   <li><a href="@Url.Action("Create", "Menus")"><em class="icon ni ni-menu"></em><span>Add Menu</span></a></li>
                                    <li><a href="@Url.Action("Index", "DepartmentFacilities")"><em class="icon ni ni-building"></em><span>Manage Facilities</span></a></li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li>
                        <a href="#" class="btn btn-outline-light" onclick="location.reload();">
                            <em class="icon ni ni-reload"></em>
                            <span>Refresh</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Analytics Overview Cards -->
    <div class="row g-gs">
        <div class="col-xxl-3 col-md-6 col-lg-4">
            <div class="card card-bordered h-100 analytics-card gradient-card gradient-primary">
                <div class="card-inner">
                    <div class="card-title-group align-items-start mb-1">
                        <div class="card-title"><h6 class="title">Total Sessions</h6></div>
                        <div class="card-tools"><em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" title="Unique user sessions (bots excluded)"></em></div>
                    </div>
                    <div class="align-items-center">
                        <div class="amount-wrap"><div class="amount h2 fw-bold text-primary mb-0">@getProp(summary, "TotalSessions")</div><span class="subtitle text-soft fs-13px">Non-bot</span></div>
                        <div class="analytics-icon"><em class="icon ni ni-users text-primary"></em></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3 col-md-6 col-lg-4">
            <div class="card card-bordered h-100 analytics-card gradient-card gradient-success">
                <div class="card-inner">
                    <div class="card-title-group align-items-start mb-1">
                        <div class="card-title"><h6 class="title">Page Views</h6></div>
                        <div class="card-tools"><em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" title="Total pages viewed"></em></div>
                    </div>
                    <div class="align-items-center">
                        <div class="amount-wrap"><div class="amount h2 fw-bold text-success mb-0">@getProp(summary, "TotalPageViews")</div><span class="subtitle text-soft fs-13px">Total</span></div>
                        <div class="analytics-icon"><em class="icon ni ni-file-docs text-success"></em></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3 col-md-6 col-lg-4">
            <div class="card card-bordered h-100 analytics-card gradient-card gradient-info">
                <div class="card-inner">
                    <div class="card-title-group align-items-start mb-1">
                        <div class="card-title"><h6 class="title">Engagement</h6></div>
                        <div class="card-tools"><em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" title="Pages per session"></em></div>
                    </div>
                    <div class="align-items-center">
                        <div class="amount-wrap"><div class="amount h2 fw-bold text-info mb-0">@getProp(summary, "AvgPagesPerSession")</div><span class="subtitle text-soft fs-13px">Pages / Session</span></div>
                        <div class="analytics-icon"><em class="icon ni ni-bar-chart text-info"></em></div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xxl-3 col-md-6 col-lg-4">
            <div class="card card-bordered h-100 analytics-card gradient-card gradient-secondary">
                <div class="card-inner">
                    <div class="card-title-group align-items-start mb-1">
                        <div class="card-title"><h6 class="title">Avg Session</h6></div>
                        <div class="card-tools"><em class="card-hint icon ni ni-help-fill" data-toggle="tooltip" title="Average session duration"></em></div>
                    </div>
                    <div class="align-items-center">
                        <div class="amount-wrap">
                            <div class="amount h2 fw-bold text-warning mb-0" title="Raw: @(getProp(summary, "AvgSessionDurationSec"))s">
                                @{ 
                                    var sessionSecondsVal = 0d; 
                                    try
                                    {
                                        var raw = getProp(summary, "AvgSessionDurationSec");
                                        if (raw != null)
                                        {
                                            sessionSecondsVal = Convert.ToDouble(raw);
                                        }
                                    }
                                    catch { }
                                    var totalSeconds = (int)Math.Round(sessionSecondsVal);
                                    int hrs = totalSeconds / 3600;
                                    int mins = (totalSeconds % 3600) / 60;
                                    int secs = totalSeconds % 60;
                                    string formatted;
                                    if (hrs > 0) { formatted = string.Format("{0}h {1}m {2}s", hrs, mins, secs); }
                                    else if (mins > 0) { formatted = string.Format("{0}m {1}s", mins, secs); }
                                    else { formatted = string.Format("{0}s", secs); }
                                } @formatted
                            </div>
                            <span class="subtitle text-soft fs-13px">Time on site</span>
                        </div>
                        <div class="analytics-icon"><em class="icon ni ni-clock text-warning"></em></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance & Page Stats Row (replaces Traffic Overview) -->
    <div class="row g-gs mt-2">
        <div class="col-xxl-8 col-lg-7">
            <!-- Replace the existing System Status card with this Web Analytics Performance card -->
            <div class="card card-bordered card-full h-100 smooth-card">
                <div class="card-inner pb-2">
                    <div class="card-title-group align-items-center mb-1">
                        <div class="card-title"><h6 class="title mb-0">Hourly Traffic (Last 24h)</h6></div>
                    </div>
                </div>
                <div class="card-inner pt-0">
                    <div class="nk-order-ovwg">
                        <div class="row g-4 align-end">
                            <div class="col-xxl-8"><div class="nk-order-ovwg-ck"><canvas id="hourlyChart" height="110"></canvas></div></div>
                            <div class="col-xxl-4">
                                <div class="row g-3">
                                    <div class="col-sm-6 col-xxl-12"><div class="nk-order-ovwg-data buy"><div class="amount">@hourly.Sum(h => getIntProp(h, "Views")) <small>views</small></div><div class="info">Last 24h</div></div></div>
                                    <div class="col-sm-6 col-xxl-12"><div class="nk-order-ovwg-data sell"><div class="amount">@{ var peakHour = hourly.OrderByDescending(h => getIntProp(h, "Views")).FirstOrDefault(); string peakHourLabel = peakHour != null ? getStringProp(peakHour, "HourLabel") : "--"; int peakViews = peakHour != null ? getIntProp(peakHour, "Views") : 0; } @peakViews <small>views</small></div><div class="info">Peak @peakHourLabel</div></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
        <div class="col-xxl-4 col-lg-5">
            <div class="card card-bordered card-full h-100 smooth-card">
                <div class="card-inner border-bottom pb-2">
                    <div class="card-title-group"><div class="card-title"><h6 class="title mb-0">Top 5 Most Viewed Pages</h6></div></div>
                </div>
                <div class="nk-tb-list compact-table">
                    <div class="nk-tb-item nk-tb-head">
                        <div class="nk-tb-col"><span>Page</span></div>
                        <div class="nk-tb-col text-right"><span>Views</span></div>
                    </div>
                    @{
                        if (!topPages.Any())
                        {
                            <div class="nk-tb-item"><div class="nk-tb-col"><span class="tb-lead text-soft">No data</span></div><div class="nk-tb-col text-right"><span class="tb-sub">-</span></div></div> }
                        else
                        {
                            foreach (dynamic p in topPages.Take(5))
                            {
                                string path = getStringProp(p, "Path");
                                int views = getIntProp(p, "Views");
                                <div class="nk-tb-item">
                                    <div class="nk-tb-col"><span class="tb-lead" title="@path" style="display:inline-block;max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><em class="icon ni ni-link text-soft mr-1"></em>@path</span></div>
                                    <div class="nk-tb-col text-right"><span class="tb-sub tb-amount"><span>@views</span></span></div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<style>
/* Unification / Cohesive styling */
.dashboard-anchor-nav .nav-link { padding: .375rem .75rem; font-size: .75rem; }
.dashboard-section { position: relative; }
.gradient-card { position: relative; overflow: hidden; }
.gradient-card:before { content: ""; position:absolute; inset:0; opacity:.08; background:linear-gradient(135deg,var(--grad-start,#6576ff),var(--grad-end,#1ee0ac)); }
.gradient-primary { --grad-start:#6576ff; --grad-end:#5b93ff; }
.gradient-success { --grad-start:#1ee0ac; --grad-end:#17c995; }
.gradient-info { --grad-start:#559bfb; --grad-end:#6576ff; }
.gradient-warning { --grad-start:#ff9f43; --grad-end:#ffc163; }
    .gradient-secondary {
        --grad-start: #f4bf17;
        --grad-end: #ff9933;
    }
.gradient-card .card-inner { backdrop-filter: blur(0px); }
.small-tabs li a { font-size:.65rem; letter-spacing:.5px; }
.smooth-card { transition: box-shadow .25s, transform .25s; }
.smooth-card:hover { box-shadow:0 4px 18px rgba(0,0,0,.08); transform:translateY(-2px); }
.section-connector { position:relative; }
.section-connector:before { content:""; position:absolute; left:10%; right:10%; top:50%; height:1px; background:linear-gradient(90deg,transparent,#6576ff 40%,#1ee0ac 60%,transparent); z-index:-1; }
.compact-table .nk-tb-item { padding-top:.25rem; padding-bottom:.25rem; }
media (max-width: 767px){ .section-connector:before{display:none;} }
.performance-card .perf-metric { position:relative; padding:.5rem .75rem .75rem; background:#f5f6fa; border-radius:6px; overflow:hidden; }
.performance-card .perf-metric .label { font-size:.7rem; text-transform:uppercase; letter-spacing:.5px; }
.performance-card .perf-metric .value { display:block; font-size:1.15rem; font-weight:700; line-height:1.1; }
.performance-card .perf-metric .delta { font-size:.75rem; font-weight:600; display:inline-block; margin-bottom:.25rem; }
.performance-card .perf-metric .delta.up { color:#28a745; }
.performance-card .perf-metric .delta.down { color:#e85347; }
.performance-card canvas { width:100%; }
.performance-card .progress.small { height:4px; background:#e5e9f2; }
.performance-card .progress-bar { transition: width .6s ease; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
    // Smooth scroll for anchor links inside dashboard nav
    document.querySelectorAll('a[href^="#analytics-section"], a[href^="#content-section"]').forEach(function(a){
        a.addEventListener('click', function(e){
            const targetId = this.getAttribute('href').substring(1);
            const targetEl = document.getElementById(targetId);
            if(targetEl){ e.preventDefault(); window.scrollTo({ top: targetEl.offsetTop - 70, behavior: 'smooth'}); }
        });
    });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var traffic = @Html.Raw(trafficJson);
    var hourly = @Html.Raw(hourlyJson);

    // Set chart defaults
    Chart.defaults.font.family = "'DM Sans', 'Helvetica', sans-serif";
    Chart.defaults.font.size = 12;
    Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(255, 255, 255, 0.95)';
    Chart.defaults.plugins.tooltip.titleColor = '#364a63';
    Chart.defaults.plugins.tooltip.bodyColor = '#8094ae';
    Chart.defaults.plugins.tooltip.borderColor = '#e5e9f2';
    Chart.defaults.plugins.tooltip.borderWidth = 1;
    Chart.defaults.plugins.tooltip.cornerRadius = 4;
    Chart.defaults.plugins.tooltip.padding = 10;
    Chart.defaults.plugins.tooltip.displayColors = false;

    // KPI deltas for sessions & page views (last 7 days vs previous 7)
    if(Array.isArray(traffic) && traffic.length){
        const last7 = traffic.slice(-7);
        const prev7 = traffic.slice(-14, -7);
        const sum = (arr, f) => arr.reduce((a,b)=>a+(b[f]||0),0);
        const sessionsLast7 = sum(last7,'Sessions');
        const sessionsPrev7 = prev7.length ? sum(prev7,'Sessions') : 0;
        const viewsLast7 = sum(last7,'PageViews');
        const viewsPrev7 = prev7.length ? sum(prev7,'PageViews') : 0;
        const pct = (cur,prev)=> prev===0 ? (cur>0?100:0) : ((cur-prev)/prev*100);
        const sDelta = pct(sessionsLast7, sessionsPrev7);
        const vDelta = pct(viewsLast7, viewsPrev7);
        const fmt = v => (v>=0?'+':'') + v.toFixed(1) + '%';
        const sessionsDeltaEl = document.getElementById('kpiSessionsDelta');
        const viewsDeltaEl = document.getElementById('kpiViewsDelta');
        if(sessionsDeltaEl){ sessionsDeltaEl.textContent = fmt(sDelta); sessionsDeltaEl.classList.add(sDelta>=0?'up':'down'); }
        if(viewsDeltaEl){ viewsDeltaEl.textContent = fmt(vDelta); viewsDeltaEl.classList.add(vDelta>=0?'up':'down'); }

        // Sparklines
        const sparkCfg = (ctx, data, color) => new Chart(ctx, { type:'line', data:{ labels:data.map(_=>''), datasets:[{ data:data, borderColor:color, backgroundColor:color+'22', borderWidth:2, fill:true, tension:.4, pointRadius:0 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}, tooltip:{enabled:false}}, scales:{ x:{display:false}, y:{display:false} }, elements:{ line:{borderJoinStyle:'round'} } } });
        const sessionsSeries = traffic.slice(-30).map(x=>x.Sessions||0);
        const pageViewSeries = traffic.slice(-30).map(x=>x.PageViews||0);
        if(document.getElementById('sparkSessions')){ sparkCfg(document.getElementById('sparkSessions').getContext('2d'), sessionsSeries, '#6576ff'); }
        if(document.getElementById('sparkPageViews')){ sparkCfg(document.getElementById('sparkPageViews').getContext('2d'), pageViewSeries, '#1ee0ac'); }
    }

    // Hourly chart
    if (hourly && hourly.length && document.getElementById('hourlyChart')) {
        var ctx2 = document.getElementById('hourlyChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: hourly.map(function(x) { return x.HourLabel; }),
                datasets: [{
                    label: 'Page Views',
                    data: hourly.map(function(x) { return x.Views; }),
                    backgroundColor: function(context) {
                        var index = context.dataIndex;
                        var value = context.dataset.data[index];
                        var maxValue = Math.max.apply(null, context.dataset.data);
                        if (value === maxValue) { return '#ff9933'; }
                        return '#6576ff';
                    },
                    borderRadius: 4,
                    maxBarThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { title: function(tooltipItems) { return tooltipItems[0].label + ' hour'; }, label: function(context) { return context.parsed.y + ' page views'; } } }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0, color: '#8094ae' }, grid: { color: '#e5e9f2', drawBorder: false }, title: { display: true, text: 'Page Views', color: '#8094ae', font: { size: 12, weight: 'normal' }, padding: {bottom: 10} } },
                    x: { grid: { display: false, drawBorder: false }, ticks: { color: '#8094ae', font: { size: 11 } }, title: { display: true, text: 'Hour of Day', color: '#8094ae', font: { size: 12, weight: 'normal' }, padding: {top: 10} } }
                },
                animation: { duration: 1000, easing: 'easeOutQuart' }
            }
        });
    }

    // Initialize tooltips (guard if bootstrap available)
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="tooltip"]'));
    if(window.bootstrap && bootstrap.Tooltip){
        tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el, { container: 'body', boundary: document.body }); });
    }
});
</script>


