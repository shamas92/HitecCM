@model HitecCM.Models.tblMenus

@{
    ViewBag.Title = "Delete Menu";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Delete Menu</h3>
                    <div class="nk-block-des text-soft">
                        <p>Are you sure you want to delete this menu?</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="alert alert-warning">
                        <em class="icon ni ni-alert-circle"></em>
                        <span>This action cannot be undone. Please confirm that you want to delete this menu.</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Menu ID</label>
                        <div class="form-control-plaintext">@Model.MenuID</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Menu Name</label>
                        <div class="form-control-plaintext">@Model.MenuName</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SvgIcon))
                    {
                        <div class="form-group">
                            <label class="form-label">SVG Icon</label>
                            <div class="form-control-plaintext">
                                <div class="d-flex align-items-center">
                                    <div style="width: 40px; height: 40px; margin-right: 10px;">
                                        <img src="@Url.Content("~/Content/img/menuicon/" + Model.SvgIcon)" alt="Menu Icon" style="max-width: 100%; max-height: 100%;" />
                                    </div>
                                    <span>@Model.SvgIcon</span>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">Menu Link</label>
                        <div class="form-control-plaintext">
                            @if (!string.IsNullOrEmpty(Model.MenuLink))
                            {
                                <a href="@Model.MenuLink" target="_blank" class="text-primary">@Model.MenuLink</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Sorting Order</label>
                        <div class="form-control-plaintext">@(Model.SortingOrder?.ToString() ?? "-")</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Parent Menu</label>
                        <div class="form-control-plaintext">@(Model.ParentMenu?.MenuName ?? "-")</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Menu Type</label>
                        <div class="form-control-plaintext">@(Model.MenuType?.MenuTypeName ?? "-")</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <div class="form-control-plaintext">
                            <span class="@(Model.Status ? "text-success" : "text-danger")">@(Model.Status ? "Active" : "Inactive")</span>
                        </div>
                    </div>

                    @using (Html.BeginForm("Delete", "Menus", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.MenuID)

                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">
                                <em class="icon ni ni-trash"></em>
                                <span>Delete Menu</span>
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <em class="icon ni ni-cross"></em>
                                <span>Cancel</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>