@model HitecCM.Models.tblMenus

@{
    ViewBag.Title = "Add New Menu";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Add New Menu</h3>
                    <div class="nk-block-des text-soft">
                        <p>Create a new menu item.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    @using (Html.BeginForm("Create", "Menus", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            @Html.LabelFor(model => model.MenuName, "Menu Name", new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.MenuName, new { @class = "form-control", placeholder = "Enter menu name" })
                            @Html.ValidationMessageFor(model => model.MenuName, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.MenuLink, "Menu Link", new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.MenuLink, new { @class = "form-control", placeholder = "Enter menu link (optional)" })
                            @Html.ValidationMessageFor(model => model.MenuLink, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.SortingOrder, "Sorting Order", new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.SortingOrder, new { @class = "form-control", type = "number", placeholder = "Enter sorting order (optional)" })
                            @Html.ValidationMessageFor(model => model.SortingOrder, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ParentMenuID, "Parent Menu", new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.ParentMenuID, ViewBag.ParentMenus as SelectList, "-- Select Parent Menu (Optional) --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ParentMenuID, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.MenuTypeID, "Menu Type *", new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.MenuTypeID, ViewBag.MenuTypes as SelectList, "-- Select Menu Type --", new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(model => model.MenuTypeID, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Status, "Status", new { @class = "form-label" })
                            <div class="custom-control custom-switch">
                                @{
                                    var statusId = "Status";
                                }
                                @Html.CheckBoxFor(model => model.Status, new { @class = "custom-control-input", id = statusId })
                                <label class="custom-control-label" for="@statusId">@(Model != null && Model.Status ? "Active" : "Inactive")</label>
                            </div>
                            @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="form-label">SVG Icon</label>
                            <div class="form-control-wrap">
                                <div class="custom-file">
                                    <input type="file" name="svgIconFile" id="svgIconFile" class="custom-file-input" accept=".svg">
                                    <label class="custom-file-label" for="svgIconFile">Choose file</label>
                                </div>
                                <small class="form-text text-muted">Upload an SVG icon for this menu (optional). Only SVG files are allowed.</small>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <em class="icon ni ni-save"></em>
                                <span>Save Menu</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Show selected filename in file input
            $('.custom-file-input').on('change', function() {
                var fileName = $(this).val().split('\\').pop();
                $(this).siblings('.custom-file-label').addClass("selected").html(fileName);
            });

            // Toggle status label text based on checkbox state
            var $statusCheckbox = $('#Status');
            function updateStatusLabel() {
                var $label = $('label[for="Status"].custom-control-label');
                if ($statusCheckbox.is(':checked')) {
                    $label.text('Active');
                    $label.removeClass('text-danger').addClass('text-success');
                } else {
                    $label.text('Inactive');
                    $label.removeClass('text-success').addClass('text-danger');
                }
            }
            if ($statusCheckbox.length) {
                updateStatusLabel();
                $statusCheckbox.on('change', updateStatusLabel);
            }
        });
    </script>
}