<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HITEC CM</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/css/dashboard.css" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/modernizr")
    <style>
        /* Layout constants */
        :root { --header-h:60px; --sidebar-w:240px; }
        /* Sidebar redesign (minimal custom CSS) */
        #sidebar { width:var(--sidebar-w); flex:0 0 var(--sidebar-w); background:#fff; border-right:1px solid #e5e9f2; position:fixed; top:var(--header-h); left:0; bottom:0; overflow-y:auto; overflow-x:hidden; }
        .sidebar-header { padding:12px 18px 4px; font-size:.65rem; letter-spacing:.15em; font-weight:700; color:#364a63; opacity:.75; }
        .sidebar-nav { list-style:none; margin:0; padding:0; }
        .sidebar-nav li { position:relative; }
        .sidebar-nav a { display:flex; align-items:center; font-weight:600; color:#4a5b75; padding:8px 18px; font-size:14px; text-decoration:none; }
        .sidebar-nav a .icon { font-size:18px; margin-right:10px; line-height:1; }
        .sidebar-nav a .caret { margin-left:auto; font-size:16px; line-height:1; width:16px; text-align:center; transition:transform .25s ease, color .15s; opacity:.65; }
        .sidebar-nav a:hover { background:#f5f6fa; color:#4a6ef2; text-decoration:none; }
        .sidebar-nav a:hover .icon, .sidebar-nav a:hover .caret { color:#4a6ef2; }
        .sidebar-nav a.active { color:#274bdb; }
        .sidebar-nav a.active .icon, .sidebar-nav a.active .caret { color:#274bdb; }
        .sidebar-nav a[aria-expanded="true"] .caret { transform:rotate(90deg); opacity:1; }
        .sidebar-sub { list-style:none; margin:0 0 4px; padding:0; }
        .sidebar-sub a { padding:6px 18px 6px 46px; font-weight:500; font-size:13px; color:#4a5b75; }
        .sidebar-sub a:hover { color:#4a6ef2; background:#f5f6fa; }
        .sidebar-sub a.active { color:#274bdb; }
        /* Header spans full width and fixed */
        .app-header { position:fixed; top:0; left:0; right:0; height:var(--header-h); z-index:1040; display:flex; align-items:center; background:#fff; border-bottom:1px solid #e5e9f2; padding:10px 18px; }
        .app-brand { display:flex; align-items:center; cursor:pointer; }
        .app-brand-icon { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#efeaff; color:#816bff; font-size:18px; margin-right:10px; }
        .app-brand-text small { display:block; font-size:.6rem; letter-spacing:.15em; font-weight:600; color:#8091a7; }
        .app-brand-text span { font-weight:700; color:#364a63; font-size:.95rem; }
        .header-actions { margin-left:auto; display:flex; align-items:center; gap:22px; }
        .header-actions .action-btn { background:none; border:0; position:relative; color:#607089; font-size:18px; padding:4px; }
        .header-actions .action-btn:focus { outline:none; }
        .header-actions .action-btn:hover { color:#4a6ef2; }
        .avatar-circle { width:38px; height:38px; border-radius:50%; background:#6576ff; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:600; }
        .mobile-toggle { margin-right:12px; }
        #appLayout { display:flex; width:100%; min-height:100vh; margin-top:var(--header-h); }
        .content-column { flex:1 1 auto; display:flex; flex-direction:column; min-width:0; margin-left:var(--sidebar-w); }
        .content-column > main { min-height:calc(100vh - var(--header-h)); }
        /* Mobile adjustments */
        @@media (max-width: 991.98px){ 
            #sidebar{ transform:translateX(-100%); box-shadow:0 0 12px rgba(0,0,0,.08); } 
            #sidebar.show{ transform:translateX(0);} 
            body.sidebar-open{ overflow:hidden;} 
            .content-column { margin-left:0; }
            .mobile-toggle{ display:inline-block; }
        }
        @@media (min-width: 992px){ .mobile-toggle{ display:none; } }
    </style>
</head>
<body>
@{ 
    var ctrl = (string)ViewContext.RouteData.Values["controller"]; 
    var action = (string)ViewContext.RouteData.Values["action"]; 
    var admissionsCtrls = new[]{"Advertisement","AcademicCalendar"};
    var facultyCtrls = new[]{"Faculty"};
    var menusCtrls = new[]{"Menus","MenuType"};
    var eventsCtrls = new[]{"Events"};
    var qacCtrls = new[]{"QAC"};
    Func<string,bool> isCtrl = c => string.Equals(ctrl,c,System.StringComparison.OrdinalIgnoreCase);
    bool admissionsActive = admissionsCtrls.Any(c=>isCtrl(c));
    bool facultyActive = facultyCtrls.Any(c=>isCtrl(c));
    bool menusActive = menusCtrls.Any(c=>isCtrl(c));
    bool eventsActive = eventsCtrls.Any(c=>isCtrl(c));
    bool qacActive = qacCtrls.Any(c=>isCtrl(c));
}
    <!-- Full-width Fixed Header -->
    <div class="app-header">
        <button class="btn btn-outline-secondary btn-sm mobile-toggle" id="sidebarToggle" type="button">☰</button>
        <div class="app-brand" onclick="window.location.href='@Url.Action("Index","Home")'">
            <div class="app-brand-icon"><em class="icon ni ni-dashlite"></em></div>
            <div class="app-brand-text"><small>HITEC</small><span>Content Management</span></div>
        </div>
        <div class="header-actions">
            <button class="action-btn" title="Chats" type="button"><em class="icon ni ni-comments"></em></button>
            <button class="action-btn" title="Notifications" type="button"><em class="icon ni ni-bell"></em></button>
            <div class="dropdown">
                <button class="action-btn dropdown-toggle p-0" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" type="button">
                    <div class="avatar-circle">A</div>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item" href="#">Profile</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#">Sign out</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Layout with fixed-width, fixed-position sidebar -->
    <div id="appLayout">
        <nav id="sidebar">
            <div class="sidebar-header">MAIN</div>
            <ul class="sidebar-nav" id="sidebarNav">
                <li><a class="@(isCtrl("Home")?"active":"")" href="@Url.Action("Index","Home")"><em class="icon ni ni-dashboard"></em><span>Dashboard</span></a></li>
                <li><a class="@(isCtrl("About")?"active":"")" href="@Url.Action("Index","About")"><em class="icon ni ni-info"></em><span>About</span></a></li>
                <li><a class="@(isCtrl("Departments")?"active":"")" href="@Url.Action("Index","Departments")"><em class="icon ni ni-building"></em><span>Departments</span></a></li>
                <li><a class="@(isCtrl("Facilities")?"active":"")" href="@Url.Action("Index","Facilities")"><em class="icon ni ni-building"></em><span>Facilities</span></a></li>
                <li><a class="@(isCtrl("Downloads")?"active":"")" href="@Url.Action("Index","Downloads")"><em class="icon ni ni-download"></em><span>Downloads</span></a></li>
                <li><a class="@(isCtrl("Policy")?"active":"")" href="@Url.Action("Index","Policy")"><em class="icon ni ni-policy"></em><span>Policies</span></a></li>
                <li>
                    <a class="submenu-toggle @(admissionsActive?"active":"")" data-target="#admissionsMenu" aria-expanded="@(admissionsActive.ToString().ToLower())"><em class="icon ni ni-book"></em><span>Admissions</span><span class="caret">›</span></a>
                    <div class="collapse @(admissionsActive?"show":"")" id="admissionsMenu">
                        <ul class="sidebar-sub">
                            <li><a class="@(isCtrl("Admissions") && action=="Advertisement"?"active":"")" href="@Url.Action("Advertisement","Admissions")">Advertisement</a></li>
                            <li><a class="@(isCtrl("Admissions") && action=="AcademicCalendar"?"active":"")" href="@Url.Action("AcademicCalendar","Admissions")">Academic Calendar</a></li>
                    </div>
                </li>
                <li>
                    <a class="submenu-toggle @(facultyActive?"active":"")" data-target="#facultyMenu" aria-expanded="@(facultyActive.ToString().ToLower())"><em class="icon ni ni-tile-thumb"></em><span>Faculty</span><span class="caret">›</span></a>
                    <div class="collapse @(facultyActive?"show":"")" id="facultyMenu">
                        <ul class="sidebar-sub">
                            <li><a class="@( (ctrl=="Faculty")?"active":"")" href="@Url.Action("VisionMission","Faculty")">Vision & Mission</a></li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a class="submenu-toggle @(menusActive?"active":"")" data-target="#menusMenu" aria-expanded="@(menusActive.ToString().ToLower())"><em class="icon ni ni-menu"></em><span>Menus</span><span class="caret">›</span></a>
                    <div class="collapse @(menusActive?"show":"")" id="menusMenu">
                        <ul class="sidebar-sub">
                            <li><a class="@(isCtrl("Menus")?"active":"")" href="@Url.Action("Index","Menus")">Menu</a></li>
                            <li><a class="@(isCtrl("MenuType")?"active":"")" href="@Url.Action("Index","MenuType")">Menu Type</a></li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a class="submenu-toggle @(eventsActive?"active":"")" data-target="#eventsMenu" aria-expanded="@(eventsActive.ToString().ToLower())"><em class="icon ni ni-calendar"></em><span>Events</span><span class="caret">›</span></a>
                    <div class="collapse @(eventsActive?"show":"")" id="eventsMenu">
                        <ul class="sidebar-sub">
                            <li><a class="@(isCtrl("Events")?"active":"")" href="@Url.Action("Index","Events")">Manage Events</a></li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a class="submenu-toggle @(qacActive?"active":"")" data-target="#qacMenu" aria-expanded="@(qacActive.ToString().ToLower())"><em class="icon ni ni-briefcase"></em><span>QA&C</span><span class="caret">›</span></a>
                    <div class="collapse @(qacActive?"show":"")" id="qacMenu">
                        <ul class="sidebar-sub">
                            <li><a class="@(isCtrl("QAC") && action=="About"?"active":"")" href="@Url.Action("About","QAC")">About QA&C</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="Policy"?"active":"")" href="@Url.Action("Policy","QAC")">Quality Assurance Policy</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="AnnualActivityCalendar"?"active":"")" href="@Url.Action("AnnualActivityCalendar","QAC")">Annual Activity Calendar</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="Organogram"?"active":"")" href="@Url.Action("Organogram","QAC")">Organogram</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="IPE"?"active":"")" href="@Url.Action("IPE","QAC")">IPE</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="RIPE"?"active":"")" href="@Url.Action("RIPE","QAC")">RIPE</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="PGPR"?"active":"")" href="@Url.Action("PGPR","QAC")">PGPR</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="SARs"?"active":"")" href="@Url.Action("SARs","QAC")">SARs</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="Surveys"?"active":"")" href="@Url.Action("Surveys","QAC")">Surveys</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="Accreditation"?"active":"")" href="@Url.Action("Accreditation","QAC")">Accreditation</a></li>
                            <li><a class="@(isCtrl("QAC") && action=="Contacts"?"active":"")" href="@Url.Action("Contacts","QAC")">Contacts</a></li>
                        </ul>
                    </div>
                </li>
            </ul>
        </nav>
        <div class="content-column">
            <main class="flex-grow-1 p-3">
                @RenderBody()
            </main>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    <script>
        (function () {
            var toggle = document.getElementById('sidebarToggle');
            if (toggle) {
                toggle.addEventListener('click', function () {
                    var sb = document.getElementById('sidebar');
                    sb.classList.toggle('show');
                    document.body.classList.toggle('sidebar-open');
                });
            }
            // Reliable submenu toggle
            $('.submenu-toggle').on('click', function (e) {
                e.preventDefault();
                var $a = $(this); var target = $a.data('target'); var $panel = $(target); var expanded = $a.attr('aria-expanded') === 'true';
                if (expanded) { $panel.stop(true,true).slideUp(160, function(){ $(this).removeClass('show'); }); $a.attr('aria-expanded','false'); }
                else { $panel.stop(true,true).slideDown(180, function(){ $(this).addClass('show'); }); $a.attr('aria-expanded','true'); }
            });
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>