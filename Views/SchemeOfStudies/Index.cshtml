@model IEnumerable<HitecCM.Models.tblSchemeOfStudy>
@{ ViewBag.Title = "Scheme of Studies"; }
@Html.AntiForgeryToken()

<div class="nk-content-inner">
  <div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
      <div class="nk-block-between">
        <div class="nk-block-head-content">
          <h3 class="nk-block-title page-title">Scheme of Studies</h3>
          <div class="nk-block-des text-soft"><p>Manage scheme of studies entries.</p></div>
        </div>
        <div class="nk-block-head-content">
          <div class="toggle-wrap nk-block-tools-toggle d-flex">
            <a href="@Url.Action("Create")" class="btn btn-primary mr-2"><em class="icon ni ni-plus"></em><span>Add New</span></a>
            <button type="button" class="btn btn-outline-light" data-toggle="collapse" data-target="#filterPanel">Filters</button>
          </div>
        </div>
      </div>
    </div>

    <div id="filterPanel" class="collapse mb-3 @(Request.QueryString.Count>0 ? "show" : "")">
      <div class="card card-bordered"><div class="card-inner">
        @using (Html.BeginForm("Index","SchemeOfStudies",FormMethod.Get)) {
          <div class="form-row align-items-end">
            <div class="form-group col-md-3">
              <label class="form-label">Program</label>
              <input type="text" name="program" value="@ViewBag.FilterProgram" class="form-control" placeholder="Program" />
            </div>
            <div class="form-group col-md-2">
              <label class="form-label">Semester</label>
              <input type="text" name="semester" value="@ViewBag.FilterSemester" class="form-control" placeholder="Semester" />
            </div>
            <div class="form-group col-md-2">
              <label class="form-label">Course Code</label>
              <input type="text" name="code" value="@ViewBag.FilterCode" class="form-control" placeholder="Code" />
            </div>
            <div class="form-group col-md-3">
              <label class="form-label">Department</label>
              @Html.DropDownList("departmentId", (SelectList)ViewBag.Departments, "-- Any --", new { @class = "form-control" })
            </div>
            <div class="form-group col-md-2">
              <label class="form-label">Program Ref</label>
              @Html.DropDownList("programId", (SelectList)ViewBag.Programs, "-- Any --", new { @class = "form-control" })
            </div>
            <div class="form-group col-md-12 d-flex justify-content-end">
              <button type="submit" class="btn btn-primary mr-2"><em class="icon ni ni-search"></em><span>Apply</span></button>
              <a href="@Url.Action("Index")" class="btn btn-light"><em class="icon ni ni-reload"></em><span>Reset</span></a>
            </div>
          </div>
        }
      </div></div>
    </div>

    @if (TempData["Success"]!=null){<div class="alert alert-success alert-dismissible fade show">@TempData["Success"]</div>}

    <div class="nk-block">
      <div class="card card-bordered card-stretch">
        <div class="card-inner p-0">
          <div class="table-responsive">
            <table class="table table-faculty">
              <thead class="thead-light">
                <tr>
                  <th style="width:70px" class="text-center">ID</th>
                  <th style="width:140px">Program</th>
                  <th style="width:100px">Semester</th>
                  <th style="width:90px">Code</th>
                  <th>Title</th>
                  <th style="width:70px">CH</th>
                  <th style="width:110px" class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>
              @if(Model!=null){
                foreach(var item in Model){
                <tr>
                  <td class="text-center"><span class="badge bg-light text-dark">@item.ID</span></td>
                  <td>@(item.Program ?? "-")</td>
                  <td>@(item.Semester ?? "-")</td>
                  <td>@(item.Code ?? "-")</td>
                  <td>@(item.Title ?? "-")</td>
                  <td>@(item.CH ?? "-")</td>
                  <td class="text-center">
                    <div class="dropdown">
                      <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                      <div class="dropdown-menu dropdown-menu-right">
                        <ul class="link-list-opt no-bdr">
                          <li><a href="@Url.Action("Edit", new { id = item.ID })"><em class="icon ni ni-edit"></em><span>Edit</span></a></li>
                          <li><a href="#" class="del-item" data-id="@item.ID" data-title="@item.Title"><em class="icon ni ni-trash"></em><span>Delete</span></a></li>
                        </ul>
                      </div>
                    </div>
                  </td>
                </tr>
                }
              }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="delModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-sm" role="document">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Confirm Delete</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
      <div class="modal-body"><p id="delText"></p><input type="hidden" id="delId" /></div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDelBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script>
$(function(){
  $('.del-item').on('click',function(e){e.preventDefault();$('#delId').val($(this).data('id'));$('#delText').text('Delete '+($(this).data('title')||'this item')+'?');$('#delModal').modal('show');});
  $('#confirmDelBtn').on('click',function(){var id=$('#delId').val();if(!id)return;$.post('@Url.Action("Delete")',{id:id,'__RequestVerificationToken':$('input[name=__RequestVerificationToken]').val()},function(r){if(r && r.success){location.reload();}else{alert((r&&r.message)||'Delete failed');}});});
});
</script>
<style>
.table-faculty { margin-bottom:0; border-collapse:separate; border-spacing:0; }
.table-faculty thead th { background:#f5f6fa; font-size:.7rem; text-transform:uppercase; letter-spacing:.5px; font-weight:600; color:#364a63; padding:.65rem .55rem; border-bottom:2px solid #e5e9f2; }
.table-faculty tbody td { padding:.6rem .55rem; font-size:.75rem; color:#526484; border-bottom:1px solid #f0f1f5; }
.badge { font-size:.65rem; padding:.35rem .55rem; }
</style>
}