@model HitecCM.Models.tblFacilite

@{
    ViewBag.Title = "Delete Facility";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Delete Facility</h3>
                    <div class="nk-block-des text-soft">
                        <p>Are you sure you want to delete this facility?</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="profile-ud wider">
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Title</div>
                                    <div class="profile-ud-value">@Model.Title</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Department</div>
                                    <div class="profile-ud-value">@(ViewBag.DepartmentTitle ?? "N/A")</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Display Order</div>
                                    <div class="profile-ud-value">@Model.C_Order</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Status</div>
                                    <div class="profile-ud-value">
                                        @if (Model.Active.GetValueOrDefault())
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            @if (!string.IsNullOrEmpty(Model.Banner))
                            {
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Banner Image</div>
                                    <div class="profile-ud-value">
                                        <img src="@Url.Content("~/Content/images/facilities/" + Model.Banner)" alt="@Model.Title" class="img-fluid rounded" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="profile-ud-item">
                                <div class="profile-ud-label">Details</div>
                                <div class="profile-ud-value">
                                    <div class="text-wrap">
                                        @Html.Raw(Model.Details)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <button type="submit" class="btn btn-danger">
                                        <em class="icon ni ni-trash"></em>
                                        <span>Delete</span>
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <em class="icon ni ni-cross"></em>
                                        <span>Cancel</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 