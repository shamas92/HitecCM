@model IEnumerable<HitecCM.Models.tblUser>
@Html.AntiForgeryToken()

@{
    ViewBag.Title = "Manage Users";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Users</h3>
                    <div class="nk-block-des text-soft">
                        <p>Manage system users and their access.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <em class="icon ni ni-plus"></em>
                            <span>Add New User</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner-group">
                    <div class="card-inner p-0">
                        <div>
                            <table class="table table-users">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center" width="80">ID</th>
                                        <th width="200">Login ID</th>
                                        <th width="250">User Name</th>
                                        <th width="200">Role</th>
                                        <th class="text-center" width="120">Status</th>
                                        <th class="text-center" width="100">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="user-row">
                                            <td class="text-center align-middle">
                                                <span class="user-id">#@item.UserID</span>
                                            </td>
                                            <td class="align-middle">
                                                <div class="user-login">
                                                    <span class="fw-bold">@item.Login</span>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="user-name">
                                                    <div class="d-flex align-items-center">
                                                        <span>@(item.UserName ?? "-")</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="user-role">
                                                    @{
                                                        var role = "User";
                                                        var badgeClass = "bg-info-dim text-info";

                                                        if (string.Equals(item.Login, "admin", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            role = "Admin";
                                                            badgeClass = "bg-primary-dim text-primary";
                                                        }
                                                        else if (string.Equals(item.Login, "DSA", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            role = "DSA";
                                                            badgeClass = "bg-warning-dim text-warning";
                                                        }
                                                    }
                                                    <span class="badge @badgeClass">@role</span>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                @if (item.Active == true)
                                                {
                                                    <span class="badge bg-success-dim text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-dim text-danger">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="dropdown">
                                                    <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-toggle="dropdown">
                                                        <em class="icon ni ni-more-h"></em>
                                                    </a>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <ul class="link-list-opt no-bdr">
                                                            <li>
                                                                <a href="@Url.Action("Edit", new { id = item.UserID })">
                                                                    <em class="icon ni ni-edit"></em>
                                                                    <span>Edit</span>
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a href="#" class="delete-user" data-id="@item.UserID" data-name="@item.UserName">
                                                                    <em class="icon ni ni-trash"></em>
                                                                    <span>Delete</span>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" tabindex="-1" id="deleteConfirmationModal">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross"></em>
            </a>
            <div class="modal-header">
                <h5 class="modal-title">Delete Confirmation</h5>
            </div>
            <div class="modal-body">
                <p id="deleteModalBody"></p>
                <input type="hidden" id="deleteUserId" />
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        $(document).ready(function () {
            // Delete confirmation
            $('.delete-user').click(function (e) {
                e.preventDefault();
                var userId = $(this).data('id');
                var userName = $(this).data('name');
                $('#deleteUserId').val(userId);
                $('#deleteModalBody').text('Are you sure you want to delete user "' + userName + '"?');
                $('#deleteConfirmationModal').modal('show');
            });

            // Confirm delete button AJAX
            $('#confirmDeleteButton').click(function () {
                var userId = $('#deleteUserId').val();
                if (!userId) return;
                $.ajax({
                    url: '/Users/Delete/' + userId,
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val(),
                        id: userId
                    },
                    success: function (response) {
                        if (response.success) {
                            $('#deleteConfirmationModal').modal('hide');
                            location.reload();
                        } else {
                            alert(response.message || 'Delete failed.');
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting.');
                    }
                });
            });

            // Initialize dropdowns
            $('.dropdown-toggle').dropdown();
        });
    </script>

    <style>
        /* Users Table Design */
        .table-users {
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .table-users thead th {
            background-color: #f5f6fa;
            color: #364a63;
            font-weight: 600;
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
            border-bottom: 2px solid #e5e9f2;
            border-top: none;
        }

        .table-users tbody td {
            padding: 1rem 0.75rem;
            border-bottom: 1px solid #f0f1f5;
            vertical-align: middle;
            color: #526484;
            font-size: 0.875rem;
        }

        .table-users tbody tr:last-child td {
            border-bottom: none;
        }

        /* User Row */
        .user-row {
            background-color: #fff;
        }

        .user-row:hover {
            background-color: #f8f9fb;
        }

        /* User ID */
        .user-id {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            background-color: #f5f6fa;
            color: #526484;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.8125rem;
        }

        /* User Avatar */
        .user-avatar {
            display: inline-flex;
        }

        .avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #6576ff;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .user-name {
            color: #364a63;
            font-weight: 500;
        }

        .user-login .fw-bold {
            font-weight: 600;
            color: #364a63;
        }

        /* Badge Styling */
        .badge {
            padding: 0.375rem 0.75rem;
            font-weight: 500;
            font-size: 0.75rem;
            border-radius: 4px;
        }

        .bg-success-dim {
            background-color: #e6f4ea;
        }

        .text-success {
            color: #1c7c54 !important;
        }

        .bg-danger-dim {
            background-color: #fdecea;
        }

        .text-danger {
            color: #c4183c !important;
        }

        .bg-primary-dim {
            background-color: #e5eaff;
        }

        .text-primary {
            color: #364a63 !important;
        }

        .bg-warning-dim {
            background-color: #fff5e6;
        }

        .text-warning {
            color: #f59e0b !important;
        }

        .bg-info-dim {
            background-color: #e6f7ff;
        }

        .text-info {
            color: #0891b2 !important;
        }
    </style>
}
