@model HitecCM.Models.tblFacultiesET
@{
    ViewBag.Title = "Vision & Mission";
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Vision & Mission</h3>
                    <div class="nk-block-des text-soft">
                        <p>Edit the Faculty Vision & Mission information below. All fields are required.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @using (Html.BeginForm("VisionMission", "Faculty", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-3">
                            @Html.Label("Faculty Vision", htmlAttributes: new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.VisionText, new { @class = "form-control w-100 summernote-minimal", placeholder = "Faculty Vision", style = "min-width: 100%;" })
                            @Html.ValidationMessageFor(m => m.VisionText, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mb-3">
                            @Html.Label("Faculty Mission", htmlAttributes: new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.MissionText, new { @class = "form-control w-100 summernote-minimal", placeholder = "Faculty Mission", style = "min-width: 100%;" })
                            @Html.ValidationMessageFor(m => m.MissionText, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-4 text-left">
                            <button type="submit" class="btn btn-primary px-5">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Content/js/editors.js")
    <script>
        NioApp.SummerNote();
    </script>
} 