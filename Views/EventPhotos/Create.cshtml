@model HitecCM.Models.tblEventPhoto
@{
    ViewBag.Title = "Add Event Photo";
    var events = ViewBag.Events as SelectList;
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Add New Event Photos</h3>
                    <div class="nk-block-des text-soft">
                        <p>Upload one or multiple photos for an event.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    @using (Html.BeginForm("Create", "EventPhotos", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        
                        <div class="form-group">
                            @Html.LabelFor(m => m.EventID, "Event *", new { @class = "form-label" })
                            @if (events != null)
                            {
                                @Html.DropDownListFor(m => m.EventID, events, "-- Select Event --", new { @class = "form-control form-select", required = "required" })
                            }
                            else
                            {
                                <select class="form-control form-select" name="EventID" required>
                                    <option value="">-- No Events Available --</option>
                                </select>
                            }
                            @Html.ValidationMessageFor(m => m.EventID, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Title, "Photo Title (Optional)", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter photo title (optional for multi-upload)" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">Note: Title will be applied to all photos when uploading multiple files</small>
                        </div>
                        
                        <div class="form-group">
                            @Html.Label("Date", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label class="form-label">Photos * (Multiple files supported)</label>
                            <div class="form-control-wrap">
                                <div class="custom-file">
                                    <input type="file" name="photoFiles" class="custom-file-input" id="photoFiles" multiple required accept="image/*">
                                    <label class="custom-file-label" for="photoFiles">Choose files</label>
                                </div>
                                <small class="form-text text-muted">
                                    Allowed formats: JPG, JPEG, PNG, GIF, WEBP. You can select multiple files at once.
                                    <br/>Files will be automatically renamed using format: EventPhotoID_Event.jpeg
                                </small>
                            </div>
                            @Html.ValidationMessageFor(m => m.Photo, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" id="previewContainer" style="display: none;">
                            <label class="form-label">Selected Photos Preview</label>
                            <div id="imagePreviewWrapper" class="row g-3"></div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Status, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Active", "Inactive" }), new { @class = "form-control form-select" })
                            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <em class="icon ni ni-save"></em>
                                <span>Upload Photo(s)</span>
                            </button>
                            <span id="uploadInfo" class="ml-3 text-muted"></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Update custom file input label with filename(s) when selected
            $('#photoFiles').on('change', function() {
                var files = this.files;
                var fileCount = files.length;
                
                if (fileCount > 0) {
                    var label = fileCount === 1 ? files[0].name : fileCount + ' files selected';
                    $(this).next('.custom-file-label').html(label);
                    $('#uploadInfo').text('(' + fileCount + ' photo(s) will be uploaded)');
                    
                    // Show previews
                    var previewWrapper = $('#imagePreviewWrapper');
                    previewWrapper.empty();
                    $('#previewContainer').show();
                    
                    for (var i = 0; i < Math.min(fileCount, 10); i++) { // Limit preview to 10 images
                        var file = files[i];
                        if (file.type.match('image.*')) {
                            var reader = new FileReader();
                            reader.onload = (function(f) {
                                return function(e) {
                                    var imgDiv = $('<div class="col-md-3 col-sm-4 col-6"></div>');
                                    var img = $('<img class="img-thumbnail" style="width: 100%; height: 150px; object-fit: cover;">');
                                    img.attr('src', e.target.result);
                                    img.attr('title', f.name);
                                    imgDiv.append(img);
                                    var fileName = $('<p class="text-center text-muted small mt-1 mb-0" style="font-size: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"></p>');
                                    fileName.text(f.name);
                                    imgDiv.append(fileName);
                                    previewWrapper.append(imgDiv);
                                };
                            })(file);
                            reader.readAsDataURL(file);
                        }
                    }
                    
                    if (fileCount > 10) {
                        var moreDiv = $('<div class="col-12 text-center text-muted"></div>');
                        moreDiv.text('... and ' + (fileCount - 10) + ' more photo(s)');
                        previewWrapper.append(moreDiv);
                    }
                } else {
                    $(this).next('.custom-file-label').html('Choose files');
                    $('#uploadInfo').text('');
                    $('#previewContainer').hide();
                }
            });

            // Form submission
            $('form').on('submit', function() {
                var fileCount = $('#photoFiles')[0].files.length;
                if (fileCount > 0) {
                    $('#submitBtn').prop('disabled', true);
                    $('#submitBtn span').text('Uploading ' + fileCount + ' photo(s)...');
                }
            });
        });
    </script>
}
