@model IEnumerable<HitecCM.Models.tblEventPhoto>
@Html.AntiForgeryToken()

@{
    ViewBag.Title = "Manage Event Photos";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
    var pageSize = (int)ViewBag.PageSize;
    var search = ViewBag.Search as string;
    var eventFilter = ViewBag.EventFilter as int?;
    var statusFilter = ViewBag.StatusFilter as string;
    var eventFilterList = ViewBag.EventFilterList as SelectList;
    
    // Calculate pagination range
    var startItem = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var endItem = Math.Min(currentPage * pageSize, totalCount);
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Event Photos</h3>
                    <div class="nk-block-des text-soft">
                        <p>Manage all event photos and their details. <strong>@totalCount</strong> total photos.</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <em class="icon ni ni-plus"></em>
                            <span>Add New Photo</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <form method="get" action="@Url.Action("Index")" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" name="search" class="form-control" placeholder="Search by title..." value="@search" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Event</label>
                            @if (eventFilterList != null)
                            {
                                <select name="eventFilter" class="form-control form-select">
                                    <option value="">All Events</option>
                                    @foreach (var item in eventFilterList)
                                    {
                                        <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select name="statusFilter" class="form-control form-select">
                                <option value="">All Status</option>
                                <option value="Active" @(statusFilter == "Active" ? "selected" : "")>Active</option>
                                <option value="Inactive" @(statusFilter == "Inactive" ? "selected" : "")>Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary">
                                <em class="icon ni ni-search"></em>
                                <span>Filter</span>
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-light">
                                <em class="icon ni ni-reload"></em>
                                <span>Reset</span>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner-group">
                    <div class="card-inner position-relative card-tools-toggle">
                        <div class="card-title-group">
                            <div class="card-tools">
                                <div class="form-inline flex-nowrap gx-3">
                                    <div class="text-soft">
                                        Showing <strong>@startItem</strong> to <strong>@endItem</strong> of <strong>@totalCount</strong> entries
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-inner p-0">
                        <div class="table-responsive">
                            <table class="table table-events">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center" width="80">ID</th>
                                        <th width="30%">Event Details</th>
                                        <th class="text-center" width="140">Photo</th>
                                        <th width="120">Date</th>
                                        <th class="text-center" width="100">Status</th>
                                        <th class="text-center" width="80">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr class="event-row">
                                                <td class="text-center align-middle">
                                                    <span class="event-id">#@item.EventPhotoID</span>
                                                </td>
                                                <td class="align-middle">
                                                    <div class="event-title-wrapper">
                                                        <h6 class="event-title mb-0">@(item.tblEvent?.Title ?? "-")</h6>
                                                        @if (!string.IsNullOrWhiteSpace(item.Title))
                                                        {
                                                            <span class="event-subtitle">@item.Title</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle">
                                                    @if (!string.IsNullOrEmpty(item.Photo))
                                                    {
                                                        <div class="event-banner-wrapper">
                                                            <img src="@Url.Content("~/Content/img/eventphotos/" + item.Photo)" 
                                                                 alt="@item.Title" 
                                                                 class="event-banner-thumb" 
                                                                 onclick="showImagePreview(this.src)" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">No Image</span>
                                                    }
                                                </td>
                                                <td class="align-middle">
                                                    <div class="event-date">
                                                        <span>@(item.Date?.ToString("dd MMM yyyy") ?? "-")</span>
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle">
                                                    @if (item.Status == "Active")
                                                    {
                                                        <span class="badge bg-success-dim text-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-dim text-danger">Inactive</span>
                                                    }
                                                </td>
                                                <td class="text-center align-middle">
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-toggle="dropdown">
                                                            <em class="icon ni ni-more-h"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-right">
                                                            <ul class="link-list-opt no-bdr">
                                                                <li>
                                                                    <a href="@Url.Action("Edit", new { id = item.EventPhotoID })">
                                                                        <em class="icon ni ni-edit"></em>
                                                                        <span>Edit</span>
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <a href="#" class="delete-photo" data-id="@item.EventPhotoID">
                                                                        <em class="icon ni ni-trash"></em>
                                                                        <span>Delete</span>
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <em class="icon ni ni-img" style="font-size: 3rem; opacity: 0.3;"></em>
                                                <p class="text-muted mt-2">No event photos found</p>
                                                @if (!string.IsNullOrWhiteSpace(search) || eventFilter.HasValue || !string.IsNullOrWhiteSpace(statusFilter))
                                                {
                                                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-light mt-2">Clear Filters</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="card-inner">
                            <div class="nk-block-between-md g-3">
                                <div class="g">
                                    <ul class="pagination justify-content-center justify-content-md-start">
                                        @* Previous Button *@
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" href="@(currentPage == 1 ? "#" : Url.Action("Index", new { page = currentPage - 1, search = search, eventFilter = eventFilter, statusFilter = statusFilter }))" tabindex="-1">
                                                <em class="icon ni ni-chevrons-left"></em>
                                                <span class="d-none d-sm-inline-block">Prev</span>
                                            </a>
                                        </li>

                                        @{
                                            var startPage = Math.Max(1, currentPage - 2);
                                            var endPage = Math.Min(totalPages, currentPage + 2);

                                            // Show first page if not in range
                                            if (startPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="@Url.Action("Index", new { page = 1, search = search, eventFilter = eventFilter, statusFilter = statusFilter })">1</a>
                                                </li>
                                                if (startPage > 2)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                            }

                                            // Page numbers
                                            for (var i = startPage; i <= endPage; i++)
                                            {
                                                <li class="page-item @(i == currentPage ? "active" : "")">
                                                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = search, eventFilter = eventFilter, statusFilter = statusFilter })">@i</a>
                                                </li>
                                            }

                                            // Show last page if not in range
                                            if (endPage < totalPages)
                                            {
                                                if (endPage < totalPages - 1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                <li class="page-item">
                                                    <a class="page-link" href="@Url.Action("Index", new { page = totalPages, search = search, eventFilter = eventFilter, statusFilter = statusFilter })">@totalPages</a>
                                                </li>
                                            }
                                        }

                                        @* Next Button *@
                                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                            <a class="page-link" href="@(currentPage >= totalPages ? "#" : Url.Action("Index", new { page = currentPage + 1, search = search, eventFilter = eventFilter, statusFilter = statusFilter }))">
                                                <span class="d-none d-sm-inline-block">Next</span>
                                                <em class="icon ni ni-chevrons-right"></em>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="g">
                                    <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                        <div class="text-muted">Page @currentPage of @totalPages</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document" style="max-width: 1200px;">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div class="modal-body p-0 text-center">
                <button type="button" class="close position-absolute" style="top: 10px; right: 10px; z-index: 1051; color: white; opacity: 1; text-shadow: 0 0 10px rgba(0,0,0,0.5);" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="font-size: 3rem;">&times;</span>
                </button>
                <img id="modalImage" src="" class="img-fluid" style="max-height: 90vh; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.3);" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showImagePreview(src) {
            $('#modalImage').attr('src', src);
            $('#imagePreviewModal').modal('show');
        }

        $(document).ready(function () {
            // Delete photo handler
            $('.delete-photo').on('click', function (e) {
                e.preventDefault();
                var photoId = $(this).data('id');
                var row = $(this).closest('tr');

                if (confirm('Are you sure you want to delete this photo?')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "EventPhotos")/' + photoId,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function () {
                            alert('An error occurred while deleting the photo.');
                        }
                    });
                }
            });
        });
    </script>

    <style>
        /* Events Table Classic Design - Consistent with Events Page */
        .table-events {
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .table-events thead th {
            background-color: #f5f6fa;
            color: #364a63;
            font-weight: 600;
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
            border-bottom: 2px solid #e5e9f2;
            border-top: none;
        }

        .table-events tbody td {
            padding: 1rem 0.75rem;
            border-bottom: 1px solid #f0f1f5;
            vertical-align: middle;
            color: #526484;
            font-size: 0.875rem;
        }

        .table-events tbody tr:last-child td {
            border-bottom: none;
        }

        /* Event Row */
        .event-row {
            background-color: #fff;
        }

        .event-row:hover {
            background-color: #f8f9fb;
        }

        /* Event ID */
        .event-id {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            background-color: #f5f6fa;
            color: #526484;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.8125rem;
        }

        /* Event Title */
        .event-title-wrapper {
            max-width: 100%;
        }

        .event-title {
            color: #364a63;
            font-weight: 600;
            font-size: 0.9375rem;
            line-height: 1.4;
            margin: 0;
        }

        .event-subtitle {
            display: block;
            color: #8094ae;
            font-size: 0.8125rem;
            margin-top: 0.25rem;
        }

        /* Event Banner */
        .event-banner-wrapper {
            display: inline-block;
        }

        .event-banner-thumb {
            width: 100px;
            height: 60px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #e5e9f2;
            cursor: pointer;
        }

        /* Event Date */
        .event-date {
            display: flex;
            align-items: center;
            color: #526484;
        }

        .event-date .icon {
            font-size: 1rem;
            margin-right: 0.375rem;
        }

        /* Badge Styling */
        .badge {
            padding: 0.375rem 0.75rem;
            font-weight: 500;
            font-size: 0.75rem;
            border-radius: 4px;
        }

        .bg-success-dim {
            background-color: #e6f4ea;
        }

        .text-success {
            color: #1c7c54 !important;
        }

        .bg-danger-dim {
            background-color: #fdecea;
        }

        .text-danger {
            color: #c4183c !important;
        }

        /* Pagination Styles */
        .pagination {
            margin: 0;
        }

        .pagination .page-item {
            margin: 0 2px;
        }

        .pagination .page-link {
            border-radius: 6px;
            border: 1px solid #e5e9f2;
            color: #526484;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
        }

        .pagination .page-link:hover {
            background-color: #f5f6fa;
            border-color: #6576ff;
            color: #6576ff;
        }

        .pagination .page-item.active .page-link {
            background-color: #6576ff;
            border-color: #6576ff;
            color: #fff;
        }

        .pagination .page-item.disabled .page-link {
            background-color: #f5f6fa;
            border-color: #e5e9f2;
            color: #b7c2d0;
            cursor: not-allowed;
        }

        .pagination .page-link .icon {
            font-size: 1rem;
            vertical-align: middle;
        }

        /* Responsive */
        @@media (max-width: 1400px) {
            .table-events thead th,
            .table-events tbody td {
                padding: 0.75rem 0.5rem;
            }
        }

        @@media (max-width: 1200px) {
            .event-banner-thumb {
                width: 80px;
                height: 50px;
            }
        }

        @@media (max-width: 768px) {
            .pagination .page-link {
                padding: 0.375rem 0.5rem;
                font-size: 0.75rem;
            }
        }
    </style>
}
