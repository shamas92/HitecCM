@model HitecCM.Models.tblEventPhoto
@{
    ViewBag.Title = "Delete Event Photo";
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Delete Event Photo</h3>
                    <div class="nk-block-des text-soft">
                        <p>Are you sure you want to delete this photo?</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <div class="toggle-wrap nk-block-tools-toggle">
                        <a href="@Url.Action("Index")" class="btn btn-outline-light">
                            <em class="icon ni ni-arrow-left"></em>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="row g-5">
                        <div class="col-lg-6">
                            <div class="profile-ud-list">
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Photo ID</div>
                                    <div class="profile-ud-value">@Model.EventPhotoID</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Event</div>
                                    <div class="profile-ud-value">@(Model.tblEvent?.Title ?? "-")</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Title</div>
                                    <div class="profile-ud-value">@Model.Title</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Date</div>
                                    <div class="profile-ud-value">@(Model.Date?.ToString("dd-MMM-yyyy"))</div>
                                </div>
                                <div class="profile-ud-item">
                                    <div class="profile-ud-label">Status</div>
                                    <div class="profile-ud-value">
                                        @if (Model.Status == "Active")
                                        {
                                            <span class="badge badge-dim bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-dim bg-danger">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            @if (!string.IsNullOrEmpty(Model.Photo))
                            {
                                <div class="profile-ud-label mb-2">Photo Preview</div>
                                <img src="@Url.Content("~/Content/img/eventphotos/" + Model.Photo)" 
                                     alt="@Model.Title" 
                                     class="img-thumbnail" 
                                     style="max-width: 100%; max-height: 400px;" />
                            }
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        @using (Html.BeginForm("Delete", "EventPhotos", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.EventPhotoID)
                            
                            <div class="alert alert-warning">
                                <em class="icon ni ni-alert-circle"></em>
                                <strong>Warning:</strong> This action cannot be undone. The photo file will be permanently deleted.
                            </div>
                            
                            <div class="form-group">
                                <button type="submit" class="btn btn-danger">
                                    <em class="icon ni ni-trash"></em>
                                    <span>Delete Photo</span>
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-outline-light">
                                    <span>Cancel</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
