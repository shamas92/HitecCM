@model HitecCM.Models.AdverQsement
@{
    ViewBag.Title = "Advertisement";
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Advertisement</h3>
                    <div class="nk-block-des text-soft">
                        <p>Edit the Advertisement information below. All fields are required.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @using (Html.BeginForm("Index", "Advertisement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-3">
                            @Html.Label("Advertisement Image", htmlAttributes: new { @class = "form-label" })
                            <div class="form-control-wrap">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="adImageFile" name="image_file" accept="image/*" onchange="previewImage(this, 'adImagePreview')">
                                    <label class="custom-file-label" for="adImageFile">Choose file</label>
                                </div>
                                <div class="mt-3">
                                    <div id="adImagePreview" style="width: 100%; height: 1700px; border: 2px dashed #ccc; display: @(string.IsNullOrEmpty(Model.ImagePath) ? "none" : "block"); background-size: cover; background-position: center; background-repeat: no-repeat; @(!string.IsNullOrEmpty(Model.ImagePath) ? $"background-image:url('{Url.Content("~/Content/img/about/" + Model.ImagePath)}');" : "")">
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mt-4 text-left">
                            <button type="submit" class="btn btn-primary px-5">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Content/js/editors.js")
    <script>
        NioApp.SummerNote();
        function previewImage(input, previewId) {
            var preview = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.style.backgroundImage = 'url(' + e.target.result + ')';
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.backgroundImage = '';
                preview.style.display = 'none';
            }
        }
    </script>
} 