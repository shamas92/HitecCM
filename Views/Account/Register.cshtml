@model HitecCM.Controllers.RegisterViewModel

@{
    ViewBag.Title = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HitecCM</title>
    
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    
    <!-- Dashlite CSS -->
    <link href="~/Content/css/dashlite.css" rel="stylesheet" />
    <link href="~/Content/css/theme.css" rel="stylesheet" />
    
    <style>
        .register-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            background-color: #f5f6fa;
        }
        
        .register-box {
            width: 100%;
            max-width: 500px;
            padding: 30px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }
        
        .register-logo {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .register-logo h2 {
            color: #364a63;
            font-weight: 600;
            margin: 0;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-control {
            height: 45px;
            padding: 10px 15px;
            border-radius: 5px;
        }
        
        .btn-register {
            height: 45px;
            font-weight: 600;
            background-color: #364a63;
            border-color: #364a63;
        }
        
        .btn-register:hover {
            background-color: #2a3a4f;
            border-color: #2a3a4f;
        }
        
        .text-danger {
            font-size: 0.875rem;
        }
        
        .validation-summary-errors {
            margin-bottom: 15px;
        }
        
        .login-link {
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>
<body class="nk-body bg-lighter">
    <div class="register-container">
        <div class="register-box">
            <div class="register-logo">
                <h2>Create Administrator Account</h2>
                <p class="text-muted">Set up your administrator account</p>
            </div>
            
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.AntiForgeryToken()
                
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                
                <div class="form-group">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-lg", placeholder = "Enter your full name" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                </div>
                
                <div class="form-group">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control form-control-lg", placeholder = "Choose a username" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
                
                <div class="form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-lg", placeholder = "Create a password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
                
                <div class="form-group">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control form-control-lg", placeholder = "Confirm your password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-register btn-block btn-lg">Create Account</button>
                </div>
            }
            
            <div class="login-link">
                @Html.ActionLink("Already have an account? Sign in", "Login", "Account", null, new { @class = "text-primary" })
            </div>
            
            <div class="text-center mt-4">
                <p class="text-muted">&copy; @DateTime.Now.Year - HitecCM Admin Panel</p>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.js"></script>
    <script src="~/Scripts/bootstrap.bundle.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>