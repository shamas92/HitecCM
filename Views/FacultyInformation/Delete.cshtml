@model HitecCM.Models.tblFaculty

@{
    ViewBag.Title = "Delete Faculty Member";
}

<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Delete Faculty Member</h3>
                    <div class="nk-block-des text-soft">
                        <p>Are you sure you want to delete this faculty member?</p>
                    </div>
                </div>
                <div class="nk-block-head-content">
                    <a href="@Url.Action("Index")" class="btn btn-outline-light bg-white">
                        <em class="icon ni ni-arrow-left"></em>
                        <span>Back to List</span>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="alert alert-warning">
                        <em class="icon ni ni-alert-circle"></em>
                        <strong>Warning!</strong> This action cannot be undone.
                    </div>
                    
                    <dl class="row">
                        <dt class="col-sm-3">Faculty ID:</dt>
                        <dd class="col-sm-9">@Model.FacultyID</dd>
                        
                        <dt class="col-sm-3">Full Name:</dt>
                        <dd class="col-sm-9">@(Model.FullName ?? "-")</dd>
                        
                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@(Model.Email ?? "-")</dd>
                        
                        <dt class="col-sm-3">Department:</dt>
                        <dd class="col-sm-9">@(Model.tblDepartment?.Title ?? "-")</dd>
                        
                        <dt class="col-sm-3">Designation:</dt>
                        <dd class="col-sm-9">
                            @if (Model.tblDesignation != null)
                            {
                                @Model.tblDesignation.Designation
                            }
                            else if (!string.IsNullOrEmpty(Model.AdDesignation))
                            {
                                @Model.AdDesignation
                            }
                            else
                            {
                                @:-
                            }
                        </dd>
                        
                        <dt class="col-sm-3">Qualification:</dt>
                        <dd class="col-sm-9">@(Model.Qualification ?? "-")</dd>
                        
                        <dt class="col-sm-3">Phone:</dt>
                        <dd class="col-sm-9">@(Model.TelNo ?? "-")</dd>
                        
                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">
                            @if (Model.StudyLeave == true)
                            {
                                <span class="badge bg-warning-dim text-warning">On Leave</span>
                            }
                            else if (Model.Active == true)
                            {
                                <span class="badge bg-success-dim text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-dim text-danger">Inactive</span>
                            }
                        </dd>
                    </dl>
                    
                    @using (Html.BeginForm("Delete", "FacultyInformation", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.FacultyID)
                        
                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-danger">
                                <em class="icon ni ni-trash"></em>
                                <span>Delete Faculty Member</span>
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge {
        padding: 0.375rem 0.75rem;
        font-weight: 500;
        font-size: 0.75rem;
        border-radius: 4px;
    }

    .bg-success-dim {
        background-color: #e6f4ea;
    }

    .text-success {
        color: #1c7c54 !important;
    }

    .bg-danger-dim {
        background-color: #fdecea;
    }

    .text-danger {
        color: #c4183c !important;
    }

    .bg-warning-dim {
        background-color: #fff5e6;
    }

    .text-warning {
        color: #f59e0b !important;
    }
</style>
