@model HitecCM.Models.AcademicCalendar
@{
    ViewBag.Title = "Academic Calendar";
}
<div class="nk-content-inner">
    <div class="nk-content-body">
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h3 class="nk-block-title page-title">Academic Calendar</h3>
                    <div class="nk-block-des text-soft">
                        <p>Edit the Academic Calendar information below. All fields are required.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="nk-block">
            <div class="card card-bordered card-stretch">
                <div class="card-inner">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @using (Html.BeginForm("Index", "AcademicCalendar", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Title, htmlAttributes: new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Title" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mb-3">
                            @Html.Label("Description", htmlAttributes: new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DescripQon, new { @class = "form-control", placeholder = "Description" })
                            @Html.ValidationMessageFor(m => m.DescripQon, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-4 text-left">
                            <button type="submit" class="btn btn-primary px-5">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}